cabal-version: 3.0
name: graph-reduction-machine
version: 0.1.0.0
build-type: Custom
synopsis: Lambda calculus graph reduction machine
category: Compilers/Interpreters
extra-source-files:
    grammar/ArithmeticLambda.cf
  , grammar/PureLambda.cf
  , grammar/Graph.cf
  , test/cases/compile/*.lambda
  , test/cases/compile/*.ski
  , test/cases/integration/*.lambda
  , test/cases/integration/*.ski
  , test/cases/errors/*.lambda
  , test/cases/errors/*.error
  , test/cases/syntax/*.lambda
  , test/cases/desugar/*.lambda

custom-setup
  setup-depends:
      base >=4.16 && <5
    , Cabal >=3.0 && <3.17
    , directory
    , process

library
  hs-source-dirs: src
  exposed-modules:
      Compiler
    , Desugar
    , ArithmeticLambda.Abs
    , ArithmeticLambda.Par
    , PureLambda.Abs
    , PureLambda.Par
    , Graph.Abs
    , Graph.Par
    , Graph.Print
  other-modules:
      ArithmeticLambda.Lex
    , PureLambda.Lex
    , Graph.Lex
  build-depends:
      base >=4.16 && <5
    , array
  build-tool-depends:
      BNFC:bnfc >=2.9.6 && <2.10
    , alex:alex >=3.2 && <4
    , happy:happy >=2 && <3
  default-language: Haskell2010

executable lambda-to-graph
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.16 && <5
    , graph-reduction-machine
  default-language: Haskell2010

test-suite compiler-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
      base >=4.16 && <5
    , directory
    , filepath
    , graph-reduction-machine
  default-language: Haskell2010
