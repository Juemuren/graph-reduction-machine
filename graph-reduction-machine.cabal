cabal-version: 3.0
name: graph-reduction-machine
version: 0.1.0.0
build-type: Custom
synopsis: Lambda calculus graph reduction machine
category: Compilers/Interpreters
extra-source-files:
    grammar/CoreLambda.cf
  , grammar/PureLambda.cf
  , grammar/Graph.cf
  , lib/*.lambda
  , test/cases/schema.json
  , test/cases/**/*.json
  , test/cases/compiler/modules/*.lambda

custom-setup
  setup-depends:
      base >=4.16 && <5
    , Cabal >=3.0 && <3.17
    , directory
    , process

library
  hs-source-dirs: src
  exposed-modules:
      Compiler
    , Expand
    , Interpreter
    , CoreLambda.Abs
    , CoreLambda.Par
    , CoreLambda.Print
    , ModuleLoader
    , PureLambda.Abs
    , PureLambda.Par
    , PureLambda.Print
    , Graph.Abs
    , Graph.Par
    , Graph.Print
  other-modules:
      CoreLambda.Lex
    , PureLambda.Lex
    , Graph.Lex
    , LibrarySource
    , ModuleSource
  build-depends:
      base >=4.16 && <5
    , array
    , containers
    , directory
    , filepath
    , mtl
    , template-haskell
  build-tool-depends:
      BNFC:bnfc >=2.9.6 && <2.10
    , alex:alex >=3.2 && <4
    , happy:happy >=2 && <3
  default-language: Haskell2010

executable lambda-to-graph
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.16 && <5
    , graph-reduction-machine
  default-language: Haskell2010

executable ski-interpreter
  hs-source-dirs: app
  main-is: SkiMain.hs
  build-depends:
      base >=4.16 && <5
    , graph-reduction-machine
  default-language: Haskell2010

test-suite compiler-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: TestSupport
  build-depends:
      base >=4.16 && <5
    , aeson >=2.0 && <3
    , bytestring
    , directory
    , filepath
    , graph-reduction-machine
    , jsonschema >=0.3 && <0.4
    , process
  build-tool-depends:
      graph-reduction-machine:lambda-to-graph
  default-language: Haskell2010

test-suite interpreter-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: InterpreterMain.hs
  other-modules: TestSupport
  build-depends:
      base >=4.16 && <5
    , aeson >=2.0 && <3
    , bytestring
    , directory
    , filepath
    , graph-reduction-machine
    , jsonschema >=0.3 && <0.4
    , process
  build-tool-depends:
      graph-reduction-machine:ski-interpreter
  default-language: Haskell2010

test-suite integration-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: IntegrationMain.hs
  other-modules: TestSupport
  build-depends:
      base >=4.16 && <5
    , aeson >=2.0 && <3
    , bytestring
    , directory
    , filepath
    , graph-reduction-machine
    , jsonschema >=0.3 && <0.4
    , process
  default-language: Haskell2010
