cabal-version: 3.0
name: graph-reduction-machine
version: 0.1.0.0
build-type: Custom
synopsis: Lambda calculus graph reduction machine
category: Compilers/Interpreters
extra-source-files:
    grammar/ArithmeticLambda.cf
  , grammar/PureLambda.cf
  , grammar/Graph.cf
  , test/cases/compiler/compile/*.lambda
  , test/cases/compiler/compile/*.ski
  , test/cases/compiler/desugar/*.lambda
  , test/cases/compiler/errors/*.lambda
  , test/cases/compiler/errors/*.error
  , test/cases/compiler/syntax/*.lambda
  , test/cases/integration/undecode/*.lambda
  , test/cases/integration/undecode/*.ski
  , test/cases/integration/decode/*.lambda
  , test/cases/integration/decode/*.decoded
  , test/cases/interpreter/reduce/*.ski
  , test/cases/interpreter/errors/*.ski
  , test/cases/interpreter/errors/*.error
  , test/cases/interpreter/limit-errors/*.ski
  , test/cases/interpreter/limit-errors/*.error
  , test/cases/interpreter/decode-errors/*.ski
  , test/cases/interpreter/decode-errors/*.error
  , test/cases/interpreter/decode-limit-errors/*.ski
  , test/cases/interpreter/decode-limit-errors/*.error

custom-setup
  setup-depends:
      base >=4.16 && <5
    , Cabal >=3.0 && <3.17
    , directory
    , process

library
  hs-source-dirs: src
  exposed-modules:
      Compiler
    , Desugar
    , Interpreter
    , ArithmeticLambda.Abs
    , ArithmeticLambda.Par
    , PureLambda.Abs
    , PureLambda.Par
    , Graph.Abs
    , Graph.Par
    , Graph.Print
  other-modules:
      ArithmeticLambda.Lex
    , PureLambda.Lex
    , Graph.Lex
  build-depends:
      base >=4.16 && <5
    , array
    , containers
    , mtl
  build-tool-depends:
      BNFC:bnfc >=2.9.6 && <2.10
    , alex:alex >=3.2 && <4
    , happy:happy >=2 && <3
  default-language: Haskell2010

executable lambda-to-graph
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base >=4.16 && <5
    , graph-reduction-machine
  default-language: Haskell2010

executable ski-interpreter
  hs-source-dirs: app
  main-is: SkiMain.hs
  build-depends:
      base >=4.16 && <5
    , graph-reduction-machine
  default-language: Haskell2010

test-suite compiler-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
      base >=4.16 && <5
    , directory
    , filepath
    , graph-reduction-machine
  default-language: Haskell2010

test-suite interpreter-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: InterpreterMain.hs
  build-depends:
      base >=4.16 && <5
    , directory
    , filepath
    , graph-reduction-machine
  default-language: Haskell2010

test-suite integration-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: IntegrationMain.hs
  build-depends:
      base >=4.16 && <5
    , directory
    , filepath
    , graph-reduction-machine
  default-language: Haskell2010
