{
  "cases": [
    {
      "name": "local-definition",
      "language": "lambda",
      "source": "identity = \\x -> x; @! identity;",
      "stage": "reduce",
      "expect": {
        "value": "\\x -> x"
      }
    },
    {
      "name": "forward-definition",
      "language": "lambda",
      "source": "first = second; second = \\x -> x; @! first;",
      "stage": "reduce",
      "expect": {
        "value": "\\x -> x"
      }
    },
    {
      "name": "lambda-shadows-definition",
      "language": "lambda",
      "source": "value = \\x -> \\y -> x; @! (\\value -> value) (\\x -> x);",
      "stage": "reduce",
      "options": {
        "enableReduce": "both"
      },
      "expect": {
        "value": "\\x -> x"
      }
    }
  ]
}
