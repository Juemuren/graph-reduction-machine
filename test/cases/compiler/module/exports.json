{
  "cases": [
    {
      "name": "exported-definition",
      "language": "lambda",
      "source": "@< \"./defs.lambda\" (identity); @! identity;",
      "modules": {
        "defs.lambda": "@> identity = \\x -> x; helper = \\x -> x;"
      },
      "stage": "reduce",
      "expect": {
        "value": "\\x -> x"
      }
    },
    {
      "name": "multiple-exports",
      "language": "lambda",
      "source": "@< \"./defs.lambda\" (first, second); @! first second;",
      "modules": {
        "defs.lambda": "@> first = \\x -> x; @> second = \\y -> y;"
      },
      "stage": "reduce",
      "options": {
        "enableReduce": "both"
      },
      "expect": {
        "value": "\\y -> y"
      }
    }
  ]
}
