{
  "cases": [
    {
      "name": "private-import",
      "language": "lambda",
      "source": "@< \"./defs.lambda\" (helper); @! helper;",
      "modules": {
        "defs.lambda": "@> identity = \\x -> x; helper = \\x -> x;"
      },
      "stage": "compile",
      "expect": {
        "error": "<input>: defs.lambda does not export helper"
      }
    },
    {
      "name": "invalid-export-definition",
      "language": "lambda",
      "source": "@< \"./defs.lambda\" (broken); @! broken;",
      "modules": {
        "defs.lambda": "@> broken = missing;"
      },
      "stage": "compile",
      "expect": {
        "error": "defs.lambda: broken: free variable(s): missing"
      }
    },
    {
      "name": "duplicate-export",
      "language": "lambda",
      "source": "@< \"./defs.lambda\" (identity); @! identity;",
      "modules": {
        "defs.lambda": "@> identity = \\x -> x; @> identity = \\y -> y;"
      },
      "stage": "compile",
      "expect": {
        "error": "defs.lambda: duplicate export: identity"
      }
    },
    {
      "name": "cyclic-definitions",
      "language": "lambda",
      "source": "a = b; b = a; @! a;",
      "stage": "compile",
      "expect": {
        "error": "cyclic definition: a -> b -> a"
      }
    },
    {
      "name": "missing-entry",
      "language": "lambda",
      "source": "x = ONE;",
      "stage": "compile",
      "expect": {
        "error": "module has no final expression"
      }
    },
    {
      "name": "missing-semicolon",
      "language": "lambda",
      "source": "name = ONE",
      "stage": "compile",
      "expect": {
        "error": "syntax error at end of file"
      }
    },
    {
      "name": "duplicate-definition",
      "language": "lambda",
      "source": "x = ONE; x = TWO; @! x;",
      "stage": "compile",
      "expect": {
        "error": "duplicate definition: x"
      }
    },
    {
      "name": "duplicate-entry",
      "language": "lambda",
      "source": "@! ONE; @! TWO;",
      "stage": "compile",
      "expect": {
        "error": "duplicate program entry"
      }
    }
  ]
}
