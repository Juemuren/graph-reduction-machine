{
  "cases": [
    {
      "name": "output-ski-explicit",
      "command": "ski-interpreter",
      "args": ["--output=ski"],
      "stdin": "#0 = I;\n",
      "expect": { "exitCode": 0, "stdout": "#0 = I;\n", "stderr": "" }
    },
    {
      "name": "output-graphviz-preserve",
      "command": "ski-interpreter",
      "args": ["--output=graphviz", "--share=preserve", "--show-steps"],
      "stdin": "#0 = #1 #3;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "digraph ski {\n  node [shape=circle];\n  \"#0\" [label=\"#0: @\"];\n  \"#0\" -> \"#1\" [label=\"function\"];\n  \"#0\" -> \"#3\" [label=\"argument\"];\n  \"#1\" [label=\"#1: @\"];\n  \"#1\" -> \"#2\" [label=\"function\"];\n  \"#1\" -> \"#3\" [label=\"argument\"];\n  \"#2\" [label=\"#2: S\"];\n  \"#3\" [label=\"#3: I\"];\n}\n",
        "stderr": "steps: 0\n"
      }
    },
    {
      "name": "output-graphviz-merge",
      "command": "ski-interpreter",
      "args": ["--share=merge", "--output=graphviz"],
      "stdin": "#0 = #1 #4;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n#4 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "digraph ski {\n  node [shape=circle];\n  \"#0\" [label=\"#0: @\"];\n  \"#0\" -> \"#1\" [label=\"function\"];\n  \"#0\" -> \"#3\" [label=\"argument\"];\n  \"#1\" [label=\"#1: @\"];\n  \"#1\" -> \"#2\" [label=\"function\"];\n  \"#1\" -> \"#3\" [label=\"argument\"];\n  \"#2\" [label=\"#2: S\"];\n  \"#3\" [label=\"#3: I\"];\n}\n",
        "stderr": ""
      }
    },
    {
      "name": "output-graphviz-unfold",
      "command": "ski-interpreter",
      "args": ["--output=graphviz", "--share=unfold"],
      "stdin": "#0 = #1 #3;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "digraph ski {\n  node [shape=circle];\n  \"#0\" [label=\"#0: @\"];\n  \"#0\" -> \"#1\" [label=\"function\"];\n  \"#0\" -> \"#4\" [label=\"argument\"];\n  \"#1\" [label=\"#1: @\"];\n  \"#1\" -> \"#2\" [label=\"function\"];\n  \"#1\" -> \"#3\" [label=\"argument\"];\n  \"#2\" [label=\"#2: S\"];\n  \"#3\" [label=\"#3: I\"];\n  \"#4\" [label=\"#4: I\"];\n}\n",
        "stderr": ""
      }
    },
    {
      "name": "output-and-decode-conflict",
      "command": "ski-interpreter",
      "args": ["--output=graphviz", "--decode=boolean"],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    },
    {
      "name": "decode-and-output-conflict",
      "command": "ski-interpreter",
      "args": ["--decode=boolean", "--output=ski"],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    },
    {
      "name": "share-preserve",
      "command": "ski-interpreter",
      "args": ["--share=preserve", "--show-steps"],
      "stdin": "#0 = #1 #3;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "#0 = #1 #3;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n",
        "stderr": "steps: 0\n"
      }
    },
    {
      "name": "share-merge-after-reduction",
      "command": "ski-interpreter",
      "args": ["--share=merge", "--show-steps"],
      "stdin": "#0 = #1 #6;\n#1 = #2 #5;\n#2 = #3 #4;\n#3 = S;\n#4 = S;\n#5 = S;\n#6 = #7 #8;\n#7 = K;\n#8 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "#0 = #1 #1;\n#1 = #2 #3;\n#2 = S;\n#3 = #4 #5;\n#4 = K;\n#5 = I;\n",
        "stderr": "steps: 1\n"
      }
    },
    {
      "name": "share-unfold",
      "command": "ski-interpreter",
      "args": ["--share=unfold", "--show-steps"],
      "stdin": "#0 = #1 #1;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "#0 = #1 #4;\n#1 = #2 #3;\n#2 = S;\n#3 = I;\n#4 = #5 #6;\n#5 = S;\n#6 = I;\n",
        "stderr": "steps: 0\n"
      }
    },
    {
      "name": "share-and-decode-conflict",
      "command": "ski-interpreter",
      "args": ["--share=merge", "--decode=boolean"],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    },
    {
      "name": "decode-and-share-conflict",
      "command": "ski-interpreter",
      "args": ["--decode=boolean", "--share=preserve"],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    },
    {
      "name": "unlimited-and-show-steps",
      "command": "ski-interpreter",
      "args": [
        "--no-step-limit",
        "--show-steps"
      ],
      "stdin": "#0 = #1 #2;\n#1 = I;\n#2 = #3 #4;\n#3 = I;\n#4 = K;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "#0 = K;\n",
        "stderr": "steps: 2\n"
      }
    },
    {
      "name": "decode-and-show-steps",
      "command": "ski-interpreter",
      "args": [
        "--decode=boolean",
        "--no-step-limit",
        "--show-steps"
      ],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "TRUE\n",
        "stderr": "steps: 1\n"
      }
    },
    {
      "name": "zero-steps",
      "command": "ski-interpreter",
      "args": [
        "--show-steps"
      ],
      "stdin": "#0 = I;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "#0 = I;\n",
        "stderr": "steps: 0\n"
      }
    },
    {
      "name": "no-steps-on-error",
      "command": "ski-interpreter",
      "args": [
        "--max-steps=1",
        "--show-steps"
      ],
      "stdin": "#0 = #1 #2;\n#1 = I;\n#2 = #3 #4;\n#3 = I;\n#4 = K;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "reduction exceeded step limit 1\n"
      }
    },
    {
      "name": "decode-scott-zero",
      "command": "ski-interpreter",
      "args": ["--decode=scott-natural", "--show-steps"],
      "stdin": "#0 = K;\n",
      "expect": {
        "exitCode": 0,
        "stdout": "0\n",
        "stderr": "steps: 1\n"
      }
    },
    {
      "name": "conflicting-step-options",
      "command": "ski-interpreter",
      "args": [
        "--max-steps=1",
        "--no-step-limit"
      ],
      "stdin": "#0 = I;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    },
    {
      "name": "decode-empty-list",
      "command": "ski-interpreter",
      "args": ["--decode=list<natural>"],
      "stdin": "#0 = #1 #2;\n#1 = K;\n#2 = I;\n",
      "expect": { "exitCode": 0, "stdout": "[]\n", "stderr": "" }
    },
    {
      "name": "decode-empty-scott-list",
      "command": "ski-interpreter",
      "args": ["--decode=scott-list<natural>"],
      "stdin": "#0 = #1 #2;\n#1 = K;\n#2 = I;\n",
      "expect": { "exitCode": 0, "stdout": "[]\n", "stderr": "" }
    },
    {
      "name": "decode-empty-string",
      "command": "ski-interpreter",
      "args": ["--decode=string"],
      "stdin": "#0 = #1 #2;\n#1 = K;\n#2 = I;\n",
      "expect": { "exitCode": 0, "stdout": "\n", "stderr": "" }
    },
    {
      "name": "decode-empty-scott-string",
      "command": "ski-interpreter",
      "args": ["--decode=string<scott<church>>"],
      "stdin": "#0 = #1 #2;\n#1 = K;\n#2 = I;\n",
      "expect": { "exitCode": 0, "stdout": "\n", "stderr": "" }
    },
    {
      "name": "invalid-composite-type",
      "command": "ski-interpreter",
      "args": ["--decode=pair<natural>"],
      "stdin": "#0 = I;\n",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: ski-interpreter [--max-steps=N|--no-step-limit] [--show-steps] [--share=preserve|merge|unfold] [--output=ski|graphviz] [--decode=natural|scott-natural|binary-natural|boolean|integer|rational|real|string|string<L<N>>|list<T>|scott-list<T>|pair<A,B>] [--precision-real=N] [FILE]\n"
      }
    }
  ]
}
