{
  "cases": [
    {
      "name": "implicit-entry-without-semicolon",
      "command": "lambda-compiler",
      "args": ["--stop-after=expand"],
      "stdin": "\\x -> x",
      "expect": {
        "exitCode": 0,
        "stdout": "\\ x -> x\n",
        "stderr": ""
      }
    },
    {
      "name": "church-numeral",
      "command": "lambda-compiler",
      "args": ["--stop-after=expand", "--encode-natural=church"],
      "stdin": "@! 2;",
      "expect": {
        "exitCode": 0,
        "stdout": "\\ f -> \\ x -> f (f x)\n",
        "stderr": ""
      }
    },
    {
      "name": "scott-numeral",
      "command": "lambda-compiler",
      "args": ["--stop-after=expand", "--encode-natural=scott"],
      "stdin": "@! 1;",
      "expect": {
        "exitCode": 0,
        "stdout": "\\ zero -> \\ successor -> successor (\\ zero -> \\ successor -> zero)\n",
        "stderr": ""
      }
    },
    {
      "name": "scott-string-empty",
      "command": "lambda-compiler",
      "args": ["--stop-after=expand", "--encode-string=scott<church>"],
      "stdin": "@! \"\";",
      "expect": {
        "exitCode": 0,
        "stdout": "\\ c -> \\ n -> n\n",
        "stderr": ""
      }
    },
    {
      "name": "invalid-encoding",
      "command": "lambda-compiler",
      "args": ["--encode-natural=other"],
      "stdin": "@! 0;",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: lambda-compiler [--stop-after=expand|reduce] [--enable-reduce=beta|eta|both] [--encode-natural=church|scott|binary] [--encode-string=church<church|scott|binary>|scott<church|scott|binary>] [FILE]\n"
      }
    },
    {
      "name": "invalid-string-encoding",
      "command": "lambda-compiler",
      "args": ["--encode-string=scott<other>"],
      "stdin": "@! \"A\";",
      "expect": {
        "exitCode": 1,
        "stdout": "",
        "stderr": "usage: lambda-compiler [--stop-after=expand|reduce] [--enable-reduce=beta|eta|both] [--encode-natural=church|scott|binary] [--encode-string=church<church|scott|binary>|scott<church|scott|binary>] [FILE]\n"
      }
    }
  ]
}
