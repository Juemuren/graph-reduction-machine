{
  "cases": [
    {
      "name": "nil-is-empty",
      "language": "lambda",
      "source": "@! ISNIL NIL;\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "cons-is-not-empty",
      "language": "lambda",
      "source": "@! ISNIL (CONS ONE NIL);\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "False" }
    },
    {
      "name": "length",
      "language": "lambda",
      "source": "@! LENGTH (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "foldr-order",
      "language": "lambda",
      "source": "@! FOLDR SUB ZERO (CONS THREE (CONS ONE NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "foldl-order",
      "language": "lambda",
      "source": "@! FOLDL SUB THREE (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "0" }
    },
    {
      "name": "head",
      "language": "lambda",
      "source": "@! HEAD ZERO (CONS TWO (CONS THREE NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "head-empty",
      "language": "lambda",
      "source": "@! HEAD THREE NIL;\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "tail",
      "language": "lambda",
      "source": "@! HEAD ZERO (TAIL (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "tail-empty",
      "language": "lambda",
      "source": "@! ISNIL (TAIL NIL);\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "index-first",
      "language": "lambda",
      "source": "@! INDEX ZERO ZERO (CONS TWO (CONS THREE NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "index-middle",
      "language": "lambda",
      "source": "@! INDEX ONE ZERO (CONS ONE (CONS THREE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "index-last",
      "language": "lambda",
      "source": "@! INDEX TWO ZERO (CONS ONE (CONS TWO (CONS FOUR NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "index-at-length",
      "language": "lambda",
      "source": "@! INDEX TWO FOUR (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "index-beyond-length",
      "language": "lambda",
      "source": "@! INDEX THREE FOUR (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "index-zero",
      "language": "lambda",
      "source": "@! INDEX ZERO FOUR (CONS ONE NIL);\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "1" }
    },
    {
      "name": "index-empty",
      "language": "lambda",
      "source": "@! INDEX ONE FOUR NIL;\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "append-order",
      "language": "lambda",
      "source": "@! FOLDR (\\x -> \\rest -> ADD x (MUL TEN rest)) ZERO (APPEND (CONS ONE NIL) (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "21" }
    },
    {
      "name": "map-order",
      "language": "lambda",
      "source": "@! HEAD ZERO (TAIL (MAP SUCC (CONS ONE (CONS TWO NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "filter-order",
      "language": "lambda",
      "source": "@! HEAD ZERO (FILTER (\\x -> GT x ONE) (CONS ONE (CONS THREE (CONS TWO NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "reverse-order",
      "language": "lambda",
      "source": "@! HEAD ZERO (REVERSE (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "take-zero",
      "language": "lambda",
      "source": "@! ISNIL (TAKE ZERO (CONS ONE NIL));\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "take-prefix-order",
      "language": "lambda",
      "source": "@! FOLDR (\\x -> \\rest -> ADD x (MUL TEN rest)) ZERO (TAKE TWO (CONS ONE (CONS TWO (CONS THREE NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "21" }
    },
    {
      "name": "take-beyond-length",
      "language": "lambda",
      "source": "@! LENGTH (TAKE FIVE (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "take-empty",
      "language": "lambda",
      "source": "@! ISNIL (TAKE TWO NIL);\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "drop-zero",
      "language": "lambda",
      "source": "@! HEAD ZERO (DROP ZERO (CONS ONE NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "1" }
    },
    {
      "name": "drop-prefix",
      "language": "lambda",
      "source": "@! HEAD ZERO (DROP TWO (CONS ONE (CONS TWO (CONS THREE NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "drop-beyond-length",
      "language": "lambda",
      "source": "@! ISNIL (DROP FIVE (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "drop-empty",
      "language": "lambda",
      "source": "@! ISNIL (DROP TWO NIL);\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "uncons-head",
      "language": "lambda",
      "source": "@! FST (UNCONS (CONS TWO (CONS THREE NIL)));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "uncons-tail",
      "language": "lambda",
      "source": "@! HEAD ZERO (SND (UNCONS (CONS TWO (CONS THREE NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "uncons-empty",
      "language": "lambda",
      "source": "@! AND (ISNIL (FST (UNCONS NIL))) (ISNIL (SND (UNCONS NIL)));\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "case-empty",
      "language": "lambda",
      "source": "@! CASE NIL FOUR (\\head -> \\tail -> ZERO);\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "case-cons",
      "language": "lambda",
      "source": "@! CASE (CONS TWO (CONS THREE NIL)) ZERO (\\head -> \\tail -> ADD head (LENGTH tail));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "3" }
    },
    {
      "name": "concat-empty",
      "language": "lambda",
      "source": "@! ISNIL (CONCAT NIL);\n",
      "stage": "decode",
      "options": { "decode": "boolean" },
      "expect": { "value": "True" }
    },
    {
      "name": "concat-order-with-empty-inner-list",
      "language": "lambda",
      "source": "@! FOLDR (\\x -> \\rest -> ADD x (MUL TEN rest)) ZERO (CONCAT (CONS (CONS ONE NIL) (CONS NIL (CONS (CONS TWO (CONS THREE NIL)) NIL))));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "321" }
    },
    {
      "name": "insert-front",
      "language": "lambda",
      "source": "@! INSERT ZERO THREE (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[3, 1, 2]" }
    },
    {
      "name": "insert-middle",
      "language": "lambda",
      "source": "@! INSERT ONE THREE (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[1, 3, 2]" }
    },
    {
      "name": "insert-end",
      "language": "lambda",
      "source": "@! INSERT TWO THREE (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[1, 2, 3]" }
    },
    {
      "name": "insert-beyond-length",
      "language": "lambda",
      "source": "@! INSERT FIVE THREE (CONS ONE NIL);\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[1, 3]" }
    },
    {
      "name": "insert-empty",
      "language": "lambda",
      "source": "@! INSERT ZERO THREE NIL;\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[3]" }
    },
    {
      "name": "sort-ascending",
      "language": "lambda",
      "source": "@! SORT LEQ (CONS THREE (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[1, 2, 3]" }
    },
    {
      "name": "sort-descending",
      "language": "lambda",
      "source": "@! SORT GEQ (CONS ONE (CONS THREE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[3, 2, 1]" }
    },
    {
      "name": "sort-duplicates",
      "language": "lambda",
      "source": "@! SORT LEQ (CONS TWO (CONS ONE (CONS TWO NIL)));\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[1, 2, 2]" }
    },
    {
      "name": "sort-empty",
      "language": "lambda",
      "source": "@! SORT LEQ NIL;\n",
      "stage": "decode",
      "options": { "decode": "list<natural>" },
      "expect": { "value": "[]" }
    },
    {
      "name": "find-first",
      "language": "lambda",
      "source": "@! FIND (\\x -> GT x ONE) ZERO (CONS TWO (CONS THREE NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "2" }
    },
    {
      "name": "find-missing",
      "language": "lambda",
      "source": "@! FIND (\\x -> GT x THREE) FOUR (CONS ONE (CONS TWO NIL));\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    },
    {
      "name": "find-empty",
      "language": "lambda",
      "source": "@! FIND (\\x -> TRUE) FOUR NIL;\n",
      "stage": "decode",
      "options": { "decode": "natural" },
      "expect": { "value": "4" }
    }
  ]
}
