{
  "cases": [
    {
      "name": "empty-literal",
      "language": "lambda",
      "source": "@! \"\";",
      "stage": "decode",
      "options": { "decode": "string" },
      "expect": { "value": "" }
    },
    {
      "name": "unicode-literal",
      "language": "lambda",
      "source": "@! \"A中😀\";",
      "stage": "decode",
      "options": { "decode": "string" },
      "expect": { "value": "A中😀" }
    },
    {
      "name": "escaped-literal",
      "language": "lambda",
      "source": "@! \"a\\n\\\"b\\\\\";",
      "stage": "decode",
      "options": { "decode": "string" },
      "expect": { "value": "a\n\"b\\" }
    },
    {
      "name": "literal-independent-of-numeric-encoding",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encode": "scott", "decode": "string" },
      "expect": { "value": "A" }
    },
    {
      "name": "church-list-church-character",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encodeString": "church<church>", "decode": "string<church<church>>" },
      "expect": { "value": "A" }
    },
    {
      "name": "church-list-scott-character",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encodeString": "church<scott>", "decode": "string<church<scott>>" },
      "expect": { "value": "A" }
    },
    {
      "name": "church-list-binary-character",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encodeString": "church<binary>", "decode": "string<church<binary>>" },
      "expect": { "value": "A" }
    },
    {
      "name": "scott-list-church-character",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encodeString": "scott<church>", "decode": "string<scott<church>>" },
      "expect": { "value": "A" }
    },
    {
      "name": "scott-list-scott-character",
      "language": "lambda",
      "source": "@! \"A\";",
      "stage": "decode",
      "options": { "encodeString": "scott<scott>", "decode": "string<scott<scott>>" },
      "expect": { "value": "A" }
    },
    {
      "name": "scott-list-binary-character",
      "language": "lambda",
      "source": "@! \"Hi\";",
      "stage": "decode",
      "options": { "encodeString": "scott<binary>", "decode": "string<scott<binary>>" },
      "expect": { "value": "Hi" }
    },
    {
      "name": "append",
      "language": "lambda",
      "source": "@! APPEND \"Hi\" \"!\";",
      "stage": "decode",
      "options": { "decode": "string" },
      "expect": { "value": "Hi!" }
    },
    {
      "name": "nested-list",
      "language": "lambda",
      "source": "@! CONS \"A\" (CONS \"B\" NIL);",
      "stage": "decode",
      "options": { "decode": "list<string>" },
      "expect": { "value": "[A, B]" }
    },
    {
      "name": "invalid-character",
      "language": "lambda",
      "source": "@! CONS 1114112 NIL;",
      "stage": "decode",
      "options": { "encode": "binary", "decode": "string" },
      "expect": { "error": "not a value of the requested type" }
    }
  ]
}
