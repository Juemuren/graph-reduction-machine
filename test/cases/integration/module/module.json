      },
      "run": {
        "stage": "decode",
        "type": "natural"
      },
      "expect": {
        "value": "2"
      }
    },
    {
      "name": "forward-definition",
      "input": {
        "language": "lambda",
        "source": "first = second; second = THREE; @! first;"
      },
      "run": {
        "stage": "decode",
        "type": "natural"
      },
      "expect": {
        "value": "3"
      }
    },
    {
      "name": "lambda-shadows-definition",
      "input": {
        "language": "lambda",
        "source": "x = ONE; @! (\\x -> x) TWO;"
      },
      "run": {
        "stage": "decode",
        "type": "natural"
      },
      "expect": {
        "value": "2"
      }
    },
    {
      "name": "import-export",
      "input": {
        "language": "lambda",
        "source": "@< \"lib/natural.lambda\" (DIV); @! DIV FIVE TWO;"
      },
      "run": {
        "stage": "decode",
        "type": "natural"
      },
      "expect": {
        "value": "2"
      }
    },
    {
      "name": "multiple-exports-from-one-module",
      "input": {
        "language": "lambda",
        "source": "@< \"lib/natural.lambda\" (ADD, TWO); @! ADD TWO ONE;"
      },
      "run": {
        "stage": "decode",
        "type": "natural"
      },
      "expect": {
        "value": "3"
      }
    }
  ]
