{
  "cases": [
    {
      "name": "ntor",
      "language": "lambda",
      "source": "@! NTOR THREE FIVE;\n",
      "stage": "decode",
      "options": {
        "decode": "rational"
      },
      "expect": {
        "value": "3/1"
      }
    },
    {
      "name": "qtor",
      "language": "lambda",
      "source": "@! QTOR (PAIR (NTOZ ONE) (NTOZ TWO)) THREE;\n",
      "stage": "decode",
      "options": {
        "decode": "rational"
      },
      "expect": {
        "value": "1/2"
      }
    },
    {
      "name": "ztor",
      "language": "lambda",
      "source": "@! ZTOR (ZNEG (NTOZ TWO)) TWO;\n",
      "stage": "decode",
      "options": {
        "decode": "rational"
      },
      "expect": {
        "value": "-2/1"
      }
    },
    {
      "name": "rnorm-numerator",
      "language": "lambda",
      "source": "@! FST (RNORM (QTOR (PAIR (NTOZ TWO) (NTOZ FOUR))) ONE);\n",
      "stage": "decode",
      "options": {
        "decode": "integer"
      },
      "expect": {
        "value": "1"
      }
    },
    {
      "name": "rnorm-denominator",
      "language": "lambda",
      "source": "@! SND (RNORM (QTOR (PAIR (NTOZ TWO) (NTOZ FOUR))) ONE);\n",
      "stage": "decode",
      "options": {
        "decode": "integer"
      },
      "expect": {
        "value": "2"
      }
    }
  ]
}
