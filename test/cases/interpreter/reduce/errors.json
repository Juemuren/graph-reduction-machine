{
  "cases": [
    {
      "name": "duplicate-node",
      "language": "ski",
      "source": "#0 = I;\n#0 = K;\n",
      "stage": "interpret",
      "options": {
        "maxSteps": 100
      },
      "expect": {
        "error": "duplicate node #0"
      }
    },
    {
      "name": "missing-root",
      "language": "ski",
      "source": "#1 = I;\n",
      "stage": "interpret",
      "options": {
        "maxSteps": 100
      },
      "expect": {
        "error": "missing root node #0"
      }
    },
    {
      "name": "reachable-cycle",
      "language": "ski",
      "source": "#0 = #1 #2;\n#1 = #0 #2;\n#2 = I;\n",
      "stage": "interpret",
      "options": {
        "maxSteps": 100
      },
      "expect": {
        "error": "cycle reachable from #0"
      }
    },
    {
      "name": "undefined-reference",
      "language": "ski",
      "source": "#0 = #1 #2;\n#1 = I;\n",
      "stage": "interpret",
      "options": {
        "maxSteps": 100
      },
      "expect": {
        "error": "undefined node #2"
      }
    }
  ]
}
