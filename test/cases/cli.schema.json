{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command line test cases",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "testCase": {
      "type": "object",
      "required": ["name", "command", "args", "stdin", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "enum": ["lambda-to-graph", "ski-interpreter"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "stdin": { "type": "string" },
        "expect": {
          "type": "object",
          "required": ["exitCode", "stdout", "stderr"],
          "properties": {
            "exitCode": { "type": "integer", "minimum": 0 },
            "stdout": { "type": "string" },
            "stderr": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
