{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph reduction machine test cases",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "testCase": {
      "type": "object",
      "required": ["name", "input", "run", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object" },
        "run": { "type": "object" },
        "expect": { "type": "object" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "input": { "$ref": "#/$defs/lambdaInput" },
            "run": { "$ref": "#/$defs/parseRun" },
            "expect": { "$ref": "#/$defs/valueOrErrorExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/lambdaInput" },
            "run": { "$ref": "#/$defs/reduceRun" },
            "expect": { "$ref": "#/$defs/valueExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/lambdaInput" },
            "run": { "$ref": "#/$defs/compileRun" },
            "expect": { "$ref": "#/$defs/graphOrErrorExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/skiInput" },
            "run": { "$ref": "#/$defs/interpretRun" },
            "expect": { "$ref": "#/$defs/graphOrErrorExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/lambdaInput" },
            "run": { "$ref": "#/$defs/undecodeRun" },
            "expect": { "$ref": "#/$defs/graphExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/lambdaInput" },
            "run": { "$ref": "#/$defs/lambdaDecodeRun" },
            "expect": { "$ref": "#/$defs/valueOrErrorExpectation" }
          }
        },
        {
          "properties": {
            "input": { "$ref": "#/$defs/skiInput" },
            "run": { "$ref": "#/$defs/skiDecodeRun" },
            "expect": { "$ref": "#/$defs/errorExpectation" }
          }
        }
      ]
    },
    "lambdaInput": {
      "type": "object",
      "required": ["language", "source"],
      "properties": {
        "language": { "const": "lambda" },
        "source": { "type": "string" },
        "modules": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "skiInput": {
      "type": "object",
      "required": ["language", "source"],
      "properties": {
        "language": { "const": "ski" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parseRun": {
      "type": "object",
      "required": ["stage"],
      "properties": { "stage": { "const": "parse" } },
      "additionalProperties": false
    },
    "reduceRun": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "const": "reduce" },
        "disableReduce": { "$ref": "#/$defs/reductionOption" }
      },
      "additionalProperties": false
    },
    "compileRun": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "const": "compile" },
        "disableReduce": { "$ref": "#/$defs/reductionOption" }
      },
      "additionalProperties": false
    },
    "interpretRun": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "const": "interpret" },
        "maxSteps": { "$ref": "#/$defs/maxSteps" }
      },
      "additionalProperties": false
    },
    "undecodeRun": {
      "type": "object",
      "required": ["stage"],
      "properties": {
        "stage": { "const": "undecode" },
        "disableReduce": { "$ref": "#/$defs/reductionOption" },
        "maxSteps": { "$ref": "#/$defs/maxSteps" }
      },
      "additionalProperties": false
    },
    "lambdaDecodeRun": {
      "type": "object",
      "required": ["stage", "type"],
      "properties": {
        "stage": { "const": "decode" },
        "type": { "$ref": "#/$defs/decodeType" },
        "precisionReal": { "$ref": "#/$defs/precisionReal" },
        "disableReduce": { "$ref": "#/$defs/reductionOption" },
        "maxSteps": { "$ref": "#/$defs/maxSteps" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/realPrecisionOnly" }]
    },
    "skiDecodeRun": {
      "type": "object",
      "required": ["stage", "type"],
      "properties": {
        "stage": { "const": "decode" },
        "type": { "$ref": "#/$defs/decodeType" },
        "precisionReal": { "$ref": "#/$defs/precisionReal" },
        "maxSteps": { "$ref": "#/$defs/maxSteps" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/realPrecisionOnly" }]
    },
    "decodeType": {
      "enum": ["natural", "boolean", "integer", "rational", "real"]
    },
    "reductionOption": {
      "enum": ["beta", "eta", "both"]
    },
    "maxSteps": {
      "type": "integer",
      "minimum": 1
    },
    "precisionReal": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of the rational approximation; defaults to 0."
    },
    "realPrecisionOnly": {
      "if": {
        "properties": { "type": { "const": "real" } },
        "required": ["type"]
      },
      "else": { "not": { "required": ["precisionReal"] } }
    },
    "valueExpectation": {
      "type": "object",
      "required": ["value"],
      "properties": { "value": { "type": "string" } },
      "additionalProperties": false
    },
    "graphExpectation": {
      "type": "object",
      "required": ["graph"],
      "properties": { "graph": { "type": "string" } },
      "additionalProperties": false
    },
    "errorExpectation": {
      "type": "object",
      "required": ["error"],
      "properties": { "error": { "type": "string" } },
      "additionalProperties": false
    },
    "graphOrErrorExpectation": {
      "oneOf": [
        { "$ref": "#/$defs/graphExpectation" },
        { "$ref": "#/$defs/errorExpectation" }
      ]
    },
    "valueOrErrorExpectation": {
      "oneOf": [
        { "$ref": "#/$defs/valueExpectation" },
        { "$ref": "#/$defs/errorExpectation" }
      ]
    }
  }
}
