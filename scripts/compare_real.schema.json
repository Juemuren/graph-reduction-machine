{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Real-number algorithm comparisons",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "methods", "exactValue", "maxIndex", "maxSteps", "csv", "png"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/method" }
        },
        "exactValue": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        "maxIndex": { "type": "integer", "minimum": 0 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "csv": { "type": "string", "minLength": 1 },
        "png": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name", "file"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
