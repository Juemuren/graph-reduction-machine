{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indexed algorithm comparisons",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "methods", "maxIndex", "maxSteps", "csv", "png"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/method" }
        },
        "maxIndex": { "type": "integer", "minimum": 0 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "csv": { "type": "string", "minLength": 1 },
        "png": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name", "file", "function", "encode", "decode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "encode": { "enum": ["church", "scott"] },
        "decode": {
          "enum": ["natural", "scott-natural", "integer", "rational", "boolean"]
        }
      },
      "additionalProperties": false
    }
  }
}
