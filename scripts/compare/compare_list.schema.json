{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Church and Scott list comparisons",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "expression", "generator", "methods", "maxLength", "maxSteps", "csv", "png"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "generator": { "$ref": "#/$defs/generator" },
        "methods": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/method" }
        },
        "maxLength": { "type": "integer", "minimum": 0 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "csv": { "type": "string", "minLength": 1 },
        "png": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "generator": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "min", "max"],
          "properties": {
            "kind": { "enum": ["ascending-cycle", "descending-cycle"] },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "constant" },
            "value": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "min", "max", "seed"],
          "properties": {
            "kind": { "const": "random" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 },
            "seed": { "type": "integer" }
          },
          "additionalProperties": false
        }
      ]
    },
    "method": {
      "type": "object",
      "required": ["name", "file", "function", "encoding", "decode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "encoding": { "enum": ["church", "scott"] },
        "decode": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
