{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Binary algorithm comparisons",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "methods", "input", "maxSteps", "csv", "png"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/method" }
        },
        "input": { "$ref": "#/$defs/input" },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "csv": { "type": "string", "minLength": 1 },
        "png": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name", "file", "function", "encode", "decode"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "encode": { "enum": ["church", "scott"] },
        "decode": {
          "enum": ["natural", "scott-natural", "integer", "rational", "boolean"]
        }
      },
      "additionalProperties": false
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "maxIndex"],
          "properties": {
            "kind": { "const": "diagonal" },
            "maxIndex": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "fixed", "maxIndex"],
          "properties": {
            "kind": { "enum": ["fixed-m", "fixed-n"] },
            "fixed": { "type": "integer", "minimum": 0 },
            "maxIndex": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "maxM", "maxN"],
          "properties": {
            "kind": { "const": "grid" },
            "maxM": { "type": "integer", "minimum": 0 },
            "maxN": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
