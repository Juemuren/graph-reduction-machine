{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "tsconfig.json",
      "client/**",
      "server/**",
      "test/**",
      "language-configuration/**",
      "syntaxes/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
