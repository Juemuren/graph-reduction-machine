{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Core Lambda",
  "scopeName": "source.core-lambda",
  "patterns": [
    { "include": "#import" },
    { "include": "#export" },
    { "include": "#entry" },
    { "include": "#definition" },
    { "include": "#expression" }
  ],
  "repository": {
    "import": {
      "name": "meta.statement.import.core-lambda",
      "begin": "(@<)",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.core-lambda" }
      },
      "end": "(;)|(?=^\\s*(?:@<|@>|@!|[A-Za-z][A-Za-z0-9_]*\\s*=))",
      "endCaptures": {
        "1": { "name": "punctuation.core-lambda" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#names" },
        { "match": "[,()]", "name": "punctuation.core-lambda" }
      ]
    },
    "export": {
      "name": "meta.statement.export.core-lambda",
      "begin": "(@>)",
      "beginCaptures": {
        "1": { "name": "keyword.control.export.core-lambda" }
      },
      "end": "(;)|(?=^\\s*(?:@<|@>|@!|[A-Za-z][A-Za-z0-9_]*\\s*=))",
      "endCaptures": {
        "1": { "name": "punctuation.core-lambda" }
      },
      "patterns": [
        { "match": "\\b[A-Za-z][A-Za-z0-9_]*\\b(?=\\s*=)", "name": "entity.name.function.definition.core-lambda" },
        { "include": "#expression" }
      ]
    },
    "entry": {
      "name": "meta.statement.entry.core-lambda",
      "begin": "(@!)",
      "beginCaptures": {
        "1": { "name": "keyword.control.entry.core-lambda" }
      },
      "end": "(;)|(?=^\\s*(?:@<|@>|@!|[A-Za-z][A-Za-z0-9_]*\\s*=))",
      "endCaptures": {
        "1": { "name": "punctuation.core-lambda" }
      },
      "patterns": [
        { "include": "#expression" }
      ]
    },
    "definition": {
      "match": "\\b([A-Za-z][A-Za-z0-9_]*)(\\s*)(=)",
      "captures": {
        "1": { "name": "entity.name.function.definition.core-lambda" },
        "3": { "name": "keyword.operator.assignment.core-lambda" }
      }
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#names" },
        { "include": "#numbers"},
        {
          "match": "(\\\\)(\\s*)([a-z][A-Za-z0-9_]*)(\\s*)(->)",
          "captures": {
            "1": { "name": "keyword.operator.lambda.core-lambda" },
            "3": { "name": "variable.parameter.core-lambda" },
            "5": { "name": "keyword.operator.arrow.core-lambda" }
          }
        },
        { "match": "@<|@>|@!", "name": "keyword.control.directive.core-lambda" },
        { "match": "=", "name": "keyword.operator.assignment.core-lambda" },
        { "match": "[,;()]", "name": "punctuation.core-lambda" }
      ]
    },
    "comments": {
      "name": "comment.line.number-sign.core-lambda",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.core-lambda",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.core-lambda" }
      ]
    },
    "names": {
      "patterns": [
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "support.function.builtin.core-lambda" },
        { "match": "\\b[a-z][A-Za-z0-9_]*\\b", "name": "variable.other.core-lambda" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.core-lambda" }
      ]
    }
  }
}
