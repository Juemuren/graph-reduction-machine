{
  "name": "graph-reduction-machine-syntax",
  "displayName": "Graph Reduction Machine Syntax",
  "description": "Syntax highlighting, completion, and hover for Core Lambda and SKI graphs.",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "graph-reduction-machine",
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "categories": [
    "Programming Languages"
  ],
  "files": [
    "README.md",
    "LICENSE.md",
    "language-configuration/*.json",
    "out/extension.js",
    "syntaxes/*.tmLanguage.json"
  ],
  "contributes": {
    "configurationDefaults": {
      "[core-lambda]": {
        "editor.wordBasedSuggestions": "off"
      },
      "[ski-graph]": {
        "editor.wordBasedSuggestions": "off"
      }
    },
    "languages": [
      {
        "id": "core-lambda",
        "aliases": [
          "Core Lambda",
          "Lambda"
        ],
        "extensions": [
          ".lambda"
        ],
        "configuration": "./language-configuration/core-lambda.json"
      },
      {
        "id": "ski-graph",
        "aliases": [
          "SKI Graph",
          "SKI"
        ],
        "extensions": [
          ".ski"
        ],
        "configuration": "./language-configuration/ski-graph.json"
      }
    ],
    "grammars": [
      {
        "language": "core-lambda",
        "scopeName": "source.core-lambda",
        "path": "./syntaxes/core-lambda.tmLanguage.json"
      },
      {
        "language": "ski-graph",
        "scopeName": "source.ski-graph",
        "path": "./syntaxes/ski-graph.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "prepackage": "npm run typecheck && npm run build",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vscode-jsonrpc": "^8.2.0"
  }
}
