@> QNORM = \p ->
  (\a ->
    (\b ->
      (\g ->
        PAIR
          (PAIR
            (DIV (FST (IF (ISZERO (FST b)) (ZNEG a) a)) g)
            (DIV (SND (IF (ISZERO (FST b)) (ZNEG a) a)) g))
          (NTOZ (DIV (ADD (FST b) (SND b)) g)))
      (GCD (ADD (FST a) (SND a)) (ADD (FST b) (SND b))))
    (ZNORM (SND p)))
  (ZNORM (FST p));
