# Rational

@> NTOQ = \n -> ZTOQ (NTOZ n);
@> ZTOQ = \z -> PAIR z (NTOZ ONE);

@> QADD = \p -> \q ->
    PAIR
        (ZADD
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZMUL (SND p) (SND q));
@> QSUB = \p -> \q ->
    PAIR
        (ZSUB
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZMUL (SND p) (SND q));
@> QMUL = \p -> \q ->
    PAIR
        (ZMUL (FST p) (FST q))
        (ZMUL (SND p) (SND q));
@> QPOW = \p -> \n -> n (QMUL p) (NTOQ ONE);
@> QDIV = \p -> \q ->
    PAIR
        (ZMUL (FST p) (SND q))
        (ZMUL (SND p) (FST q));

@> QNEG = \q -> PAIR (ZNEG (FST q)) (SND q);
@> QABS = \q ->
    IF (ZLT (ZMUL (FST q) (SND q)) (NTOZ ZERO))
        (QNEG q)
        q;
@> QINV = \q -> PAIR (SND q) (FST q);

# binary logarithm digit extraction
qLogFractionStep = \base -> \state ->
    (\square ->
        IF (QGEQ square base)
            (PAIR
                (SUCC (MUL TWO (FST state)))
                (QDIV square base))
            (PAIR
                (MUL TWO (FST state))
                square))
    (QMUL (SND state) (SND state));
qLogPositive = \base -> \number -> \precision ->
    (\whole ->
        (\fraction ->
            QADD
                (NTOQ (FST whole))
                (QDIV
                    (NTOQ (FST fraction))
                    (NTOQ (POW TWO precision))))
        (precision (qLogFractionStep base)
            (PAIR ZERO (SND whole))))
    (WHILE
        (\state -> QGEQ (SND state) base)
        (\state ->
            PAIR
                (SUCC (FST state))
                (QDIV (SND state) base))
        (PAIR ZERO number));
@> QLOG = \base -> \number -> \precision ->
    (\inverse_base -> \inverse_number ->
        (\result ->
            IF (IF inverse_base (NOT inverse_number) inverse_number)
                (QNEG result)
                result)
        (qLogPositive
            (IF inverse_base (QINV base) base)
            (IF inverse_number (QINV number) number)
            precision))
    (QLT base (NTOQ ONE))
    (QLT number (NTOQ ONE));

@> QMAX = \p -> \q -> IF (QGEQ p q) p q;
@> QMIN = \p -> \q -> IF (QLEQ p q) p q;

@> QNORM = \q ->
    (\numerator ->
        (\denominator ->
            (\divisor ->
                PAIR
                    (PAIR
                        (DIV
                            (FST (IF (ISZERO (FST denominator)) (ZNEG numerator) numerator))
                            divisor)
                        (DIV
                            (SND (IF (ISZERO (FST denominator)) (ZNEG numerator) numerator))
                            divisor))
                    (NTOZ (DIV (ADD (FST denominator) (SND denominator)) divisor)))
            (GCD
                (ADD (FST numerator) (SND numerator))
                (ADD (FST denominator) (SND denominator))))
        (ZNORM (SND q)))
    (ZNORM (FST q));

@> QISZERO = \q -> ZEQ (FST q) (NTOZ ZERO);
@> QEQ = \p -> \q ->
    ZEQ
        (ZMUL (FST p) (SND q))
        (ZMUL (FST q) (SND p));
@> QNEQ = \p -> \q -> NOT (QEQ p q);
@> QLT = \p -> \q ->
    IF (ZLT (ZMUL (SND p) (SND q)) (NTOZ ZERO))
        (ZGT
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZLT
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)));
@> QLEQ = \p -> \q ->
    IF (ZLT (ZMUL (SND p) (SND q)) (NTOZ ZERO))
        (ZGEQ
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZLEQ
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)));
@> QGT = \p -> \q -> QLT q p;
@> QGEQ = \p -> \q -> QLEQ q p;
