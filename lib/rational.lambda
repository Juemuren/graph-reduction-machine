# Rational

# Construction

@> NTOQ = \n -> ZTOQ (NTOZ n);
@> ZTOQ = \z -> PAIR z (NTOZ ONE);
@> ZTOQ_DIV = \a -> \b -> PAIR a b;
@> ZTOQ_POW = \p -> \z ->
    IF (ZLT z (NTOZ ZERO))
        (QINV (ZTOQ (ZPOW p (FST (ZABS z)))))
        (ZTOQ (ZPOW p (FST (ZABS z))));

# Unary operations

@> QNEG = \q -> PAIR (ZNEG (FST q)) (SND q);
@> QABS = \q ->
    IF (ZLT (ZMUL (FST q) (SND q)) (NTOZ ZERO))
        (QNEG q)
        q;
@> QINV = \q -> PAIR (SND q) (FST q);
@> QNORM = \q ->
    (\numerator ->
        (\denominator ->
            (\divisor ->
                PAIR
                    (PAIR
                        (DIV
                            (FST (IF (ISZERO (FST denominator)) (ZNEG numerator) numerator))
                            divisor)
                        (DIV
                            (SND (IF (ISZERO (FST denominator)) (ZNEG numerator) numerator))
                            divisor))
                    (NTOZ (DIV (ADD (FST denominator) (SND denominator)) divisor)))
            (GCD
                (ADD (FST numerator) (SND numerator))
                (ADD (FST denominator) (SND denominator))))
        (ZNORM (SND q)))
    (ZNORM (FST q));

# Symmetric binary operations

@> QADD = \p -> \q ->
    PAIR
        (ZADD
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZMUL (SND p) (SND q));
@> QMUL = \p -> \q ->
    PAIR
        (ZMUL (FST p) (FST q))
        (ZMUL (SND p) (SND q));
@> QMAX = \p -> \q -> IF (QGEQ p q) p q;
@> QMIN = \p -> \q -> IF (QLEQ p q) p q;

# Asymmetric binary operations

@> QSUB = \p -> \q ->
    PAIR
        (ZSUB
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZMUL (SND p) (SND q));
@> QDIV = \p -> \q ->
    PAIR
        (ZMUL (FST p) (SND q))
        (ZMUL (SND p) (FST q));
qNaturalPow = \p -> \n -> n (QMUL p) (NTOQ ONE);
@> QPOW = \p -> \z ->
    IF (ZLT z (NTOZ ZERO))
        (QINV (qNaturalPow p (FST (ZABS z))))
        (qNaturalPow p (FST (ZABS z)));
# Comparison

@> QISZERO = \q -> ZEQ (FST q) (NTOZ ZERO);
@> QEQ = \p -> \q ->
    ZEQ
        (ZMUL (FST p) (SND q))
        (ZMUL (FST q) (SND p));
@> QNEQ = \p -> \q -> NOT (QEQ p q);
@> QLT = \p -> \q ->
    IF (ZLT (ZMUL (SND p) (SND q)) (NTOZ ZERO))
        (ZGT
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZLT
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)));
@> QLEQ = \p -> \q ->
    IF (ZLT (ZMUL (SND p) (SND q)) (NTOZ ZERO))
        (ZGEQ
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)))
        (ZLEQ
            (ZMUL (FST p) (SND q))
            (ZMUL (FST q) (SND p)));
@> QGT = \p -> \q -> QLT q p;
@> QGEQ = \p -> \q -> QLEQ q p;
