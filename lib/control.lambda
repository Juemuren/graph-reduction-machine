# Control

@> IF = \condition -> \true -> \false ->
    condition true false;

@> FIX = Y;

@> FOR = \natural -> \step -> \initial ->
    natural step initial;
@> WHILE = \condition -> \step -> \initial ->
    FIX (\loop -> \state ->
        IF (condition state)
            (loop (step state))
            state)
        initial;
