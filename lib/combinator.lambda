# Combinators

# Basic combinators

@> I = \x -> x;
@> K = \x -> \y -> x;
@> S = \f -> \g -> \x -> f x (g x);

# Function combinators

@> B = \f -> \g -> \x -> f (g x);
@> C = \f -> \x -> \y -> f y x;
@> W = \f -> \x -> f x x;
@> M = \f -> f f;
@> T = \x -> \f -> f x;
@> V = \x -> \y -> \f -> f x y;
@> D = \f -> \g -> \h -> \x -> f (g (h x));

# Fixed-point combinators

@> Y = \f ->
    (\x -> f (x x))
    (\x -> f (x x));
@> Z = \f ->
    (\x -> f (\v -> x x v))
    (\x -> f (\v -> x x v));
@> A = \x -> \f -> f (x x f);
@> THETA = A A;
