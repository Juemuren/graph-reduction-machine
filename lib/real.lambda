# Real

# Construction from numbers

@> NTOR = \n -> QTOR (NTOQ n);
@> ZTOR = \z -> QTOR (ZTOQ z);
@> QTOR = \q -> \n -> q;

# Rational power as a Cauchy sequence

qRootWhole = \numerator -> \denominator -> \degree ->
    WHILE
        (\root -> LEQ (MUL denominator (POW (SUCC root) degree)) numerator)
        SUCC
        ZERO;
qRootDigit = \denominator -> \degree -> \radix -> \state ->
    (\root -> \remainder ->
        IF (ISZERO remainder)
            (PAIR (MUL TWO root) ZERO)
            ((\twice_root -> \scaled_remainder -> \difference ->
                IF (GEQ scaled_remainder difference)
                    (PAIR (SUCC twice_root) (SUB scaled_remainder difference))
                    (PAIR twice_root scaled_remainder))
            (MUL TWO root)
            (MUL radix remainder)
            (MUL denominator
                (SUB
                    (POW (SUCC (MUL TWO root)) degree)
                    (POW (MUL TWO root) degree)))))
    (FST state) (SND state);
qRootDigits = \numerator -> \denominator -> \degree -> \n ->
    (\whole ->
        (\state ->
            PAIR (NTOZ (FST state)) (NTOZ (POW TWO n)))
        (n (qRootDigit denominator degree (POW TWO degree))
            (PAIR whole
                (SUB numerator (MUL denominator (POW whole degree))))))
    (qRootWhole numerator denominator degree);
@> QTOR_POW = \a -> \b ->
    (\exponent ->
        (\degree ->
            (\target -> \n ->
                IF (EQ degree ONE)
                    target
                    ((\positive ->
                        (\result ->
                            IF (QLT target (NTOQ ZERO)) (QNEG result) result)
                        (qRootDigits
                            (FST (FST positive))
                            (FST (SND positive))
                            degree
                            n))
                    (QNORM (QABS target))))
            (QPOW a (FST exponent)))
        (FST (SND exponent)))
    (QNORM b);

# Rational logarithm as a Cauchy sequence

qLogFractionStep = \base -> \state ->
    (\square ->
        IF (QGEQ square base)
            (PAIR
                (SUCC (MUL TWO (FST state)))
                (QDIV square base))
            (PAIR
                (MUL TWO (FST state))
                square))
    (QMUL (SND state) (SND state));
qLogPositive = \base -> \number -> \precision ->
    (\whole ->
        (\fraction ->
            QADD
                (NTOQ (FST whole))
                (QDIV
                    (NTOQ (FST fraction))
                    (NTOQ (POW TWO precision))))
        (precision (qLogFractionStep base)
            (PAIR ZERO (SND whole))))
    (WHILE
        (\state -> QGEQ (SND state) base)
        (\state ->
            PAIR
                (SUCC (FST state))
                (QDIV (SND state) base))
        (PAIR ZERO number));
@> QTOR_LOG = \base -> \number -> \precision ->
    (\inverse_base -> \inverse_number ->
        (\result ->
            IF (IF inverse_base (NOT inverse_number) inverse_number)
                (QNEG result)
                result)
        (qLogPositive
            (IF inverse_base (QINV base) base)
            (IF inverse_number (QINV number) number)
            precision))
    (QLT base (NTOQ ONE))
    (QLT number (NTOQ ONE));

# Natural constant e

eStep = \state ->
    (\term ->
        PAIR
            (SUCC (FST state))
            (PAIR
                term
                (QADD (SND (SND state)) term)))
    (QDIV
        (FST (SND state))
        (NTOQ (SUCC (FST state))));
@> E = \n ->
    SND (SND (FOR n eStep
        (PAIR ZERO (PAIR (NTOQ ONE) (NTOQ ONE)))));

# Circle constant pi
piArcStep = \square -> \state ->
    (\index -> \term ->
        PAIR
            (SUCC index)
            (PAIR
                (QNEG (QDIV
                    (QMUL term (NTOQ (SUCC (MUL TWO index))))
                    (NTOQ (MUL square (SUCC (SUCC (SUCC (MUL TWO index))))))))
                (QADD (SND (SND state)) term)))
    (FST state) (FST (SND state));
piArc = \base -> \square -> \n ->
    SND (SND (FOR (SUCC n) (piArcStep square)
        (PAIR ZERO (PAIR (QINV (NTOQ base)) (NTOQ ZERO)))));
@> PI = \n ->
    QMUL (NTOQ FOUR)
        (QADD (piArc TWO FOUR n) (piArc THREE NINE n));

# Unary operations

@> RNEG = \a -> \n -> QNEG (a n);
@> RABS = \a -> \n -> QABS (a n);
@> RINV = \a -> \n ->
    IF (QISZERO (a n))
        (NTOQ ZERO)
        (QINV (a n));
@> RNORM = \a -> \n -> QNORM (a n);
@> EXP = \r -> RPOW E r;
@> LN = \r -> \n -> QTOR_LOG (E (SUCC n)) (r n) n;

# Sine and Cosine Taylor partial sums
trigStep = \square -> \offset -> \state ->
    (\index -> \term ->
        PAIR
            (SUCC index)
            (PAIR
                (QNEG (QDIV
                    (QMUL term square)
                    (NTOQ (MUL
                        (ADD (MUL TWO index) offset)
                        (SUCC (ADD (MUL TWO index) offset))))))
                (QADD (SND (SND state)) term)))
    (FST state) (FST (SND state));
trigSum = \x -> \first -> \offset -> \n ->
    SND (SND (FOR (SUCC n) (trigStep (QMUL x x) offset)
        (PAIR ZERO (PAIR first (NTOQ ZERO)))));
@> SIN = \r -> \n -> trigSum (r n) (r n) TWO n;
@> COS = \r -> \n -> trigSum (r n) (NTOQ ONE) ONE n;

# Symmetric binary operations

@> RADD = \a -> \b -> \n -> QADD (a n) (b n);
@> RMUL = \a -> \b -> \n -> QMUL (a n) (b n);
@> RMAX = \a -> \b -> \n -> QMAX (a n) (b n);
@> RMIN = \a -> \b -> \n -> QMIN (a n) (b n);

# Asymmetric binary operations

@> RSUB = \a -> \b -> \n -> QSUB (a n) (b n);
@> RPOW = \a -> \b -> \n -> QTOR_POW (a n) (b n) n;
@> RLOG = \base -> \number -> \n -> QTOR_LOG (base n) (number n) n;
@> RDIV = \a -> \b -> \n ->
    IF (QISZERO (b n))
        (NTOQ ZERO)
        (QDIV (a n) (b n));

# Comparison

@> RISZERO = \a -> \n -> QISZERO (a n);
@> REQ = \a -> \b -> \n -> QEQ (a n) (b n);
@> RNEQ = \a -> \b -> \n -> QNEQ (a n) (b n);
@> RLT = \a -> \b -> \n -> QLT (a n) (b n);
@> RLEQ = \a -> \b -> \n -> QLEQ (a n) (b n);
@> RGT = \a -> \b -> \n -> QGT (a n) (b n);
@> RGEQ = \a -> \b -> \n -> QGEQ (a n) (b n);
