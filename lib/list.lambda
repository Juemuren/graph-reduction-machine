# Lists

# ---
# Church encoding
# ---

# Construction

@> NIL = \c -> \n -> n;
@> CONS = \head -> \tail -> \c -> \n -> c head (tail c n);

# Operations

# Traversal

@> FOLDR = \f -> \initial -> \list -> list f initial;
@> FOLDL = \f -> \initial -> \list ->
    list (\item -> \rest -> \acc -> rest (f acc item)) (\acc -> acc) initial;

# Transformation

@> MAP = \f -> \list -> \c -> \n -> list (\item -> \rest -> c (f item) rest) n;
@> FILTER = \predicate -> \list -> \c -> \n ->
    list
        (\item -> \rest ->
            IF (predicate item)
                (c item rest)
                rest)
        n;
@> REVERSE = \list -> FOLDL (\acc -> \item -> CONS item acc) NIL list;
@> INSERT = \index -> \item -> \list ->
    APPEND (TAKE index list) (CONS item (DROP index list));

sortInsertStep = \predicate -> \item -> \state ->
    PAIR
        (CONS item (FST state))
        (\value ->
            IF (predicate value item)
                (CONS value (CONS item (FST state)))
                (CONS item (SND state value)));
sortInsertInit = (PAIR NIL (\item -> CONS item NIL));
sortInsert = \predicate -> \value -> \list ->
    SND
        (list
            (sortInsertStep predicate)
            sortInsertInit)
    value;
@> SORT = \predicate -> \list ->
    FOLDR (sortInsert predicate) NIL list;

# Deconstruction

@> HEAD = \default -> \list -> list (\item -> \rest -> item) default;
@> TAIL = \list ->
    FST (list
        (\item -> \pair -> PAIR (SND pair) (CONS item (SND pair)))
        (PAIR NIL NIL));
@> INDEX = \index -> \default -> \list ->
    list
        (\item -> \rest -> \remaining ->
            IF (ISZERO remaining)
                item
                (rest (PRED remaining)))
        (\remaining -> default)
        index;
@> FIND = \predicate -> \default -> \list ->
    list
        (\item -> \rest ->
            IF (predicate item)
                item
                rest)
        default;
@> TAKE = \n -> \list -> \c -> \empty ->
    list
        (\item -> \rest -> \remaining ->
            IF (ISZERO remaining)
                empty
                (c item (rest (PRED remaining))))
        (\remaining -> empty)
        n;
@> DROP = \n -> \list -> n TAIL list;
@> UNCONS = \list -> PAIR (HEAD NIL list) (TAIL list);
@> CASE = \list -> \empty -> \cons ->
    IF (ISNIL list)
        empty
        (cons (HEAD NIL list) (TAIL list));

# Combination

@> APPEND = \left -> \right -> left CONS right;
@> CONCAT = \lists -> lists APPEND NIL;

# Measurement

@> LENGTH = \list -> list (\item -> \rest -> SUCC rest) ZERO;

# Comparison

@> ISNIL = \list -> list (\item -> \rest -> FALSE) TRUE;
