# Natural

# ---
# Church-encoded
# ---

# Construction

@> ZERO = \f -> \x -> x;
@> SUCC = \n -> \f -> \x -> f (n f x);
@> ONE = SUCC ZERO;
@> TWO = SUCC ONE;
@> THREE = SUCC TWO;
@> FOUR = SUCC THREE;
@> FIVE = SUCC FOUR;
@> SIX = SUCC FIVE;
@> SEVEN = SUCC SIX;
@> EIGHT = SUCC SEVEN;
@> NINE = SUCC EIGHT;
@> TEN = SUCC NINE;

# Unary operations

@> PRED = \n -> \f -> \x -> n (\g -> \h -> h (g f)) (\u -> x) (\u -> u);
@> FACT = \n ->
    SND (FOR n
        (\count_product ->
            PAIR
                (SUCC (FST count_product))
                (MUL (SUCC (FST count_product)) (SND count_product)))
        (PAIR ZERO ONE));

# Symmetric binary operations

@> ADD = \m -> \n -> \f -> \x -> m f (n f x);
@> MUL = \m -> \n -> \f -> m (n f);
@> GCD = \m -> \n ->
    FST (WHILE
        (\pair -> NOT (ISZERO (SND pair)))
        (\pair -> PAIR (SND pair) (MOD (FST pair) (SND pair)))
        (PAIR m n));
@> LCM = \m -> \n ->
    IF (OR (ISZERO m) (ISZERO n))
        ZERO
        (DIV (MUL m n) (GCD m n));
@> MAX = \m -> \n -> IF (GEQ m n) m n;
@> MIN = \m -> \n -> IF (LEQ m n) m n;

# Asymmetric binary operations

@> SUB = \m -> \n -> n PRED m;
@> POW = \m -> \n -> n m;

# Division helpers

divModStep = \divisor -> \quotient_remainder ->
    IF (LEQ divisor (SUCC (SND quotient_remainder)))
        (PAIR
            (SUCC (FST quotient_remainder))
            (SUB (SUCC (SND quotient_remainder)) divisor)
        )
        (PAIR
            (FST quotient_remainder)
            (SUCC (SND quotient_remainder))
        );
divMod = \m -> \n ->
    IF (ISZERO n)
        (PAIR ZERO m)
        (m (divModStep n) (PAIR ZERO ZERO));

@> DIV = \m -> \n -> FST (divMod m n);
@> MOD = \m -> \n -> SND (divMod m n);
@> LOG = \base -> \number ->
    FST (WHILE
        (\state -> GEQ (SND state) base)
        (\state ->
            PAIR
                (SUCC (FST state))
                (DIV (SND state) base))
        (PAIR ZERO number));

# Comparison

@> ISZERO = \n -> n (\x -> FALSE) TRUE;
@> EQ = \m -> \n -> AND (LEQ m n) (LEQ n m);
@> NEQ = \m -> \n -> NOT (EQ m n);
@> LT = \m -> \n -> NOT (LEQ n m);
@> LEQ = \m -> \n -> ISZERO (SUB m n);
@> GT = \m -> \n -> NOT (LEQ m n);
@> GEQ = \m -> \n -> LEQ n m;

# ---
# Scott-encoded
# ---

# Construction

@> ZERO_S = \zero -> \successor -> zero;
@> SUCC_S = \n -> \zero -> \successor -> successor n;

# Unary operations

@> PRED_S = \n -> n ZERO_S (\predecessor -> predecessor);

# Symmetric binary operations

@> ADD_S = Y (\add -> \m -> \n ->
    m n (\predecessor -> SUCC_S (add predecessor n))
);

# Asymmetric binary operations

@> SUB_S = Y (\sub -> \m -> \n ->
    n m (\predecessor -> sub (PRED_S m) predecessor)
);

# Comparison

@> ISZERO_S = \n -> n TRUE (\predecessor -> FALSE);

