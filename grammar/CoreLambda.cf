-- Lambda expressions and modules. BNFC generates CoreLambda.*.
entrypoints Exp, Program;

PEmpty.      Program   ::= ;
PImport.     Program   ::= "@<" String "(" [NameRef] ")" ";" Program ;
PExport.     Program   ::= "@>" NameRef "=" Exp ";" Program ;
PDefinition. Program   ::= NameRef "=" Exp ";" Program ;
PEntry.      Program   ::= "@!" Exp EntryTail ;
PImplicit.   Program   ::= Exp FinalSemi ;

EEnd.        EntryTail ::= ;
EContinue.   EntryTail ::= ";" Program ;
FNone.       FinalSemi ::= ;
FPresent.    FinalSemi ::= ";" ;
separator NameRef "," ;

NVariable.   NameRef   ::= Name ;
NBuiltin.    NameRef   ::= Builtin ;

EAbs.        Exp       ::= "\\" Name "->" Exp ;
_.           Exp       ::= Exp1 ;
EApp.        Exp1      ::= Exp1 Exp2 ;
_.           Exp1      ::= Exp2 ;
EVar.        Exp2      ::= Name ;
EBuiltin.    Exp2      ::= Builtin ;
ENumber.     Exp2      ::= Integer ;
_.           Exp2      ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
token Builtin (upper (letter | digit | '_')*) ;
comment "#" ;
