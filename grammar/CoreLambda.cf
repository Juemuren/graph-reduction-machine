-- Lambda expressions with Church-encoded built-ins. BNFC generates CoreLambda.*.
entrypoints Exp;

EAbs.    Exp  ::= "\\" Name "->" Exp ;
_.       Exp  ::= Exp1 ;
EApp.    Exp1 ::= Exp1 Exp2 ;
_.       Exp1 ::= Exp2 ;
EVar.    Exp2 ::= Name ;
EZero.   Exp2 ::= "ZERO" ;
EOne.    Exp2 ::= "ONE" ;
ETwo.    Exp2 ::= "TWO" ;
EThree.  Exp2 ::= "THREE" ;
EFour.   Exp2 ::= "FOUR" ;
EFive.   Exp2 ::= "FIVE" ;
ESix.    Exp2 ::= "SIX" ;
ESeven.  Exp2 ::= "SEVEN" ;
EEight.  Exp2 ::= "EIGHT" ;
ENine.   Exp2 ::= "NINE" ;
ESucc.   Exp2 ::= "SUCC" ;
EPred.   Exp2 ::= "PRED" ;
EAdd.    Exp2 ::= "ADD" ;
ESub.    Exp2 ::= "SUB" ;
EMul.    Exp2 ::= "MUL" ;
EPow.    Exp2 ::= "POW" ;
EIsZero. Exp2 ::= "ISZERO" ;
ELeq.    Exp2 ::= "LEQ" ;
ELt.     Exp2 ::= "LT" ;
EGeq.    Exp2 ::= "GEQ" ;
EGt.     Exp2 ::= "GT" ;
EEq.     Exp2 ::= "EQ" ;
ENeq.    Exp2 ::= "NEQ" ;
EStep.   Exp2 ::= "STEP" ;
EDiv.    Exp2 ::= "DIV" ;
EMod.    Exp2 ::= "MOD" ;
EGcd.    Exp2 ::= "GCD" ;
EFact.   Exp2 ::= "FACT" ;
ELcm.    Exp2 ::= "LCM" ;
EFalse.  Exp2 ::= "FALSE" ;
ETrue.   Exp2 ::= "TRUE" ;
EAnd.    Exp2 ::= "AND" ;
EOr.     Exp2 ::= "OR" ;
ENot.    Exp2 ::= "NOT" ;
EPair.   Exp2 ::= "PAIR" ;
EFst.    Exp2 ::= "FST" ;
ESnd.    Exp2 ::= "SND" ;
EInt.    Exp2 ::= "INT" ;
ENeg.    Exp2 ::= "NEG" ;
EZAbs.   Exp2 ::= "ABS" ;
EZNorm.  Exp2 ::= "ZNORM" ;
EZAdd.   Exp2 ::= "ZADD" ;
EZSub.   Exp2 ::= "ZSUB" ;
EZMul.   Exp2 ::= "ZMUL" ;
ERat.    Exp2 ::= "RAT" ;
EQNorm.  Exp2 ::= "QNORM" ;
EQAdd.   Exp2 ::= "QADD" ;
EQSub.   Exp2 ::= "QSUB" ;
EQMul.   Exp2 ::= "QMUL" ;
EQDiv.   Exp2 ::= "QDIV" ;
EIf.     Exp2 ::= "IF" ;
EY.      Exp2 ::= "Y" ;
EFor.    Exp2 ::= "FOR" ;
EWhile.  Exp2 ::= "WHILE" ;
_.       Exp2 ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
comment "#" ;
