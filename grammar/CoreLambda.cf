-- Lambda expressions with Church-encoded built-ins. BNFC generates CoreLambda.*.
entrypoints Exp;

EAbs.    Exp  ::= "\\" Name "->" Exp ;
_.       Exp  ::= Exp1 ;
EApp.    Exp1 ::= Exp1 Exp2 ;
_.       Exp1 ::= Exp2 ;
EVar.    Exp2 ::= Name ;
EZero.   Exp2 ::= "ZERO" ;
ESucc.   Exp2 ::= "SUCC" ;
EPred.   Exp2 ::= "PRED" ;
EAdd.    Exp2 ::= "ADD" ;
ESub.    Exp2 ::= "SUB" ;
EMul.    Exp2 ::= "MUL" ;
EPow.    Exp2 ::= "POW" ;
EIsZero. Exp2 ::= "ISZERO" ;
ELeq.    Exp2 ::= "LEQ" ;
ELt.     Exp2 ::= "LT" ;
EGeq.    Exp2 ::= "GEQ" ;
EGt.     Exp2 ::= "GT" ;
EEq.     Exp2 ::= "EQ" ;
ENeq.    Exp2 ::= "NEQ" ;
EStep.   Exp2 ::= "STEP" ;
EDiv.    Exp2 ::= "DIV" ;
EMod.    Exp2 ::= "MOD" ;
EFalse.  Exp2 ::= "FALSE" ;
ETrue.   Exp2 ::= "TRUE" ;
EAnd.    Exp2 ::= "AND" ;
EOr.     Exp2 ::= "OR" ;
ENot.    Exp2 ::= "NOT" ;
EPair.   Exp2 ::= "PAIR" ;
EFst.    Exp2 ::= "FST" ;
ESnd.    Exp2 ::= "SND" ;
ENeg.    Exp2 ::= "NEG" ;
EZAbs.   Exp2 ::= "ABS" ;
EZAdd.   Exp2 ::= "ZADD" ;
EZSub.   Exp2 ::= "ZSUB" ;
EZMul.   Exp2 ::= "ZMUL" ;
EQAdd.   Exp2 ::= "QADD" ;
EQSub.   Exp2 ::= "QSUB" ;
EQMul.   Exp2 ::= "QMUL" ;
EQDiv.   Exp2 ::= "QDIV" ;
EIf.     Exp2 ::= "IF" ;
_.       Exp2 ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
comment "#" ;
