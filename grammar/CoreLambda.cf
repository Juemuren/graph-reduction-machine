-- Lambda expressions and modules. BNFC generates CoreLambda.*.
entrypoints Exp, Program;

PModule.     Program   ::= [Statement] ;
SImport.     Statement ::= "@<" String "(" [NameRef] ")" ";" ;
SExport.     Statement ::= "@>" NameRef "=" Exp ";" ;
SDefinition. Statement ::= NameRef "=" Exp ";" ;
SEntry.      Statement ::= "@!" Exp ";" ;
terminator Statement "" ;
separator NameRef "," ;

NVariable.   NameRef   ::= Name ;
NBuiltin.    NameRef   ::= Builtin ;

EAbs.        Exp       ::= "\\" Name "->" Exp ;
_.           Exp       ::= Exp1 ;
EApp.        Exp1      ::= Exp1 Exp2 ;
_.           Exp1      ::= Exp2 ;
EVar.        Exp2      ::= Name ;
EBuiltin.    Exp2      ::= Builtin ;
ENumber.     Exp2      ::= Integer ;
_.           Exp2      ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
token Builtin (upper (letter | digit | '_')*) ;
comment "#" ;
