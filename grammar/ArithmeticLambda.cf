-- Lambda expressions with arithmetic syntax. BNFC generates ArithmeticLambda.*.
entrypoints Exp;

-- Abstraction binds less tightly than addition, which binds less tightly
-- than application. Addition and application associate to the left.
EAbs. Exp  ::= "\\" Name "->" Exp ;
_.    Exp  ::= Exp1 ;
EAdd. Exp1 ::= Exp1 "+" Exp2 ;
_.    Exp1 ::= Exp2 ;
EApp. Exp2 ::= Exp2 Exp3 ;
_.    Exp2 ::= Exp3 ;
EVar. Exp3 ::= Name ;
ENat. Exp3 ::= Integer ;
_.    Exp3 ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
comment "--" ;
