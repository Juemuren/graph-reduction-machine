-- Lambda expressions with arithmetic syntax. BNFC generates ArithmeticLambda.*.
entrypoints Exp;

{-
Precedence, from lowest to highest:

- def
- or
- and
- add / sub
- mul
- neg / not
- pow
- succ / pred
- apply

Right associative:

- pow

Left associative:

- add / sub / mul
- or / and
- apply
-}

EAbs.    Exp  ::= "\\" Name "->" Exp ;
_.       Exp  ::= Exp1 ;
EOr.     Exp1 ::= Exp1 "|" Exp2 ;
_.       Exp1 ::= Exp2 ;
EAnd.    Exp2 ::= Exp2 "&" Exp3 ;
_.       Exp2 ::= Exp3 ;
EAdd.    Exp3 ::= Exp3 "+" Exp4 ;
ESub.    Exp3 ::= Exp3 "-" Exp4 ;
EZAdd.   Exp3 ::= Exp3 "+z" Exp4 ;
EZSub.   Exp3 ::= Exp3 "-z" Exp4 ;
_.       Exp3 ::= Exp4 ;
EMul.    Exp4 ::= Exp4 "*" Exp5 ;
_.       Exp4 ::= Exp5 ;
ENeg.    Exp5 ::= "-" Exp5 ;
ENot.    Exp5 ::= "!" Exp5 ;
EPow.    Exp5 ::= Exp6 "^" Exp5 ;
_.       Exp5 ::= Exp6 ;
ESucc.   Exp6 ::= Exp6 "++" ;
EPred.   Exp6 ::= Exp6 "--" ;
_.       Exp6 ::= Exp7 ;
EApp.    Exp7 ::= Exp7 Exp8 ;
_.       Exp7 ::= Exp8 ;
EVar.    Exp8 ::= Name ;
-- Data syntax sugar.
EFalseLit. Exp8 ::= "false" ;
ETrueLit.  Exp8 ::= "true" ;
ENat.    Exp8 ::= Integer ;
-- Built-in functions.
EZero.   Exp8 ::= "ZERO" ;
ESuccOp. Exp8 ::= "SUCC" ;
EPredOp. Exp8 ::= "PRED" ;
EAddOp.  Exp8 ::= "ADD" ;
ESubOp.  Exp8 ::= "SUB" ;
EMulOp.  Exp8 ::= "MUL" ;
EPowOp.  Exp8 ::= "POW" ;
EFalse.  Exp8 ::= "FALSE" ;
ETrue.   Exp8 ::= "TRUE" ;
EAndOp.  Exp8 ::= "AND" ;
EOrOp.   Exp8 ::= "OR" ;
ENotOp.  Exp8 ::= "NOT" ;
EPair.   Exp8 ::= "PAIR" ;
EFst.    Exp8 ::= "FST" ;
ESnd.    Exp8 ::= "SND" ;
EIntPos. Exp8 ::= "INT" "+" Integer ;
EIntNeg. Exp8 ::= "INT" "-" Integer ;
ENegOp.  Exp8 ::= "NEG" ;
EZAddOp. Exp8 ::= "ZADD" ;
EZSubOp. Exp8 ::= "ZSUB" ;
_.       Exp8 ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
comment "#" ;
