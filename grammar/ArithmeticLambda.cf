-- Lambda expressions with arithmetic syntax. BNFC generates ArithmeticLambda.*.
entrypoints Exp;

{-
Precedence, from lowest to highest:

- def
- add
- mul
- neg
- pow
- apply

Right associative:

- pow

Left associative:

- add
- sub
- mul
- apply
-}
EAbs.   Exp  ::= "\\" Name "->" Exp ;
_.      Exp  ::= Exp1 ;
EAdd.   Exp1 ::= Exp1 "+" Exp2 ;
EZAdd.  Exp1 ::= Exp1 "+z" Exp2 ;
EZSub.  Exp1 ::= Exp1 "-z" Exp2 ;
_.      Exp1 ::= Exp2 ;
EMul.   Exp2 ::= Exp2 "*" Exp3 ;
_.      Exp2 ::= Exp3 ;
ENeg.   Exp3 ::= "-" Exp3 ;
EPow.   Exp3 ::= Exp4 "^" Exp3 ;
_.      Exp3 ::= Exp4 ;
EApp.   Exp4 ::= Exp4 Exp5 ;
_.      Exp4 ::= Exp5 ;
EVar.   Exp5 ::= Name ;
ENat.   Exp5 ::= Integer ;
EIntPos. Exp5 ::= "INT" "+" Integer ;
EIntNeg. Exp5 ::= "INT" "-" Integer ;
ENegOp. Exp5 ::= "NEG" ;
EZAddOp. Exp5 ::= "ZADD" ;
EZSubOp. Exp5 ::= "ZSUB" ;
EAddOp. Exp5 ::= "ADD" ;
EMulOp. Exp5 ::= "MUL" ;
EPowOp. Exp5 ::= "POW" ;
EFalse. Exp5 ::= "FALSE" ;
ETrue.  Exp5 ::= "TRUE" ;
EPair.  Exp5 ::= "PAIR" ;
EFst.   Exp5 ::= "FST" ;
ESnd.   Exp5 ::= "SND" ;
_.      Exp5 ::= "(" Exp ")" ;

token Name (lower (letter | digit | '_')*) ;
comment "--" ;
