# (p_0, q_0) = (3, 2); preserve p^2 - 2q^2 = 1.
pellStep = \state ->
    (\p -> \q ->
        PAIR
            (ADD (MUL THREE p) (MUL FOUR q))
            (ADD (MUL TWO p) (MUL THREE q)))
    (FST state) (SND state);
pellInit = (PAIR THREE TWO);
pellValue = \state -> PAIR (NTOZ (FST state)) (NTOZ (SND state));
pellRoot = \n -> pellValue (FOR n pellStep pellInit);

@! pellRoot;
