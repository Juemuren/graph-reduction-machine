# Church numerals and their arithmetic.
zero = \f -> \x -> x;
succ = \n -> \f -> \x -> f (n f x);
pred = \n -> \f -> \x ->
    n (\g -> \h -> h (g f)) (\u -> x) (\u -> u);

isZero = \n -> n (\x -> FALSE) TRUE;
geq = \m -> \n -> isZero (sub n m);

@> add = \m -> \n -> \f -> \x -> m f (n f x);
@> mul = \m -> \n -> \f -> m (n f);
@> sub = \m -> \n -> n pred m;

divTrans = \n -> \p ->
    IF (geq (SND p) n)
        (PAIR (succ (FST p)) (sub (SND p) n))
        p;
divInit = \m -> PAIR zero m;
@> div = \m -> \n ->
    IF (isZero n)
        zero
        (FST (m (divTrans n) (divInit m)));
