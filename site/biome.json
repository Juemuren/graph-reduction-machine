{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": true,
  "files": {
    "includes": ["src/**", "astro.config.ts", "biome.json", "tsconfig.json"]
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "ignore",
      "bracketSameLine": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "astro": "all"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
