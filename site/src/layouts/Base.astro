---
import "katex/dist/katex.min.css";

const { title, description = "λ 演算图归约机的示例、源码与参考文档" } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <title>{title} · Graph Reduction Machine</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/" aria-label="首页">
          <span class="brand-mark">λ</span>
          <span>Graph Reduction Machine</span>
        </a>
        <nav aria-label="主导航">
          <a href="/examples/">示例</a>
          <a href="/docs/">文档</a>
          <a href="/docs/lib/">标准库</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="container footer-inner">
        <span>Graph Reduction Machine</span>
        <span>从 λ 演算到 SKI 图</span>
      </div>
    </footer>
  </body>
</html>
<style is:global>
:root {
  font-family:
    Inter, ui-sans-serif, system-ui, "Noto Sans SC", "Microsoft YaHei",
    sans-serif;
  color: #17243b;
  background: #f7f8fa;
  font-synthesis: none;
  scroll-behavior: smooth;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  min-width: 320px;
}
a {
  color: #275ca5;
  text-underline-offset: 3px;
}
a:hover {
  color: #17447f;
}
a:focus-visible,
button:focus-visible {
  outline: 3px solid #e5a33a;
  outline-offset: 3px;
}
img {
  max-width: 100%;
  height: auto;
}
main {
  min-height: calc(100vh - 170px);
}
.container {
  max-width: 1120px;
  margin: auto;
  padding: 0 24px;
}
.topbar {
  background: #13253e;
  color: #fff;
}
.topbar-inner {
  max-width: 1120px;
  margin: auto;
  padding: 0 24px;
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand {
  color: #fff;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 750;
  letter-spacing: 0.01em;
}
.brand:hover,
.topbar nav a:hover {
  color: #fff;
}
.brand-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid #9fc4f9;
  border-radius: 8px;
  color: #d6e7ff;
  font-family: Georgia, serif;
  font-size: 24px;
}
.topbar nav {
  display: flex;
  gap: 24px;
}
.topbar nav a {
  color: #d7e3f3;
  text-decoration: none;
  font-size: 14px;
}
.skip-link {
  position: absolute;
  top: -100px;
  left: 12px;
  background: #fff;
  padding: 10px;
  z-index: 5;
}
.skip-link:focus {
  top: 12px;
}
footer {
  border-top: 1px solid #dfe4ec;
  color: #66758b;
  font-size: 13px;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding-top: 28px;
  padding-bottom: 28px;
}
.eyebrow {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #c4812d;
}
.page-head {
  padding: 52px 0 32px;
}
.page-head h1 {
  font-size: clamp(32px, 5vw, 52px);
  line-height: 1.12;
  letter-spacing: -0.035em;
  margin: 12px 0 14px;
}
.page-head p {
  color: #57677e;
  line-height: 1.7;
  max-width: 720px;
  margin: 0;
}
.crumbs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  color: #66758b;
  font-size: 13px;
  margin-bottom: 22px;
}
main .crumbs a {
  text-decoration: none;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin: 0 0 64px;
}
.card {
  display: block;
  background: #fff;
  border: 1px solid #e1e6ed;
  border-radius: 12px;
  padding: 24px;
  text-decoration: none;
  color: #17243b;
  box-shadow: 0 3px 12px #18355508;
  transition:
    transform 0.15s,
    box-shadow 0.15s;
}
.card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 25px #18355514;
  color: #17243b;
}
.card small {
  color: #b3772a;
  font-weight: 800;
  letter-spacing: 0.1em;
}
.card h2,
.card h3 {
  margin: 11px 0 8px;
  font-size: 20px;
}
.card p {
  margin: 0;
  color: #65748a;
  font-size: 14px;
  line-height: 1.6;
}
.paper {
  background: #fff;
  border: 1px solid #e1e6ed;
  border-radius: 12px;
  padding: clamp(22px, 4vw, 48px);
  margin-bottom: 56px;
  box-shadow: 0 5px 24px #18355508;
}
.prose {
  line-height: 1.8;
  overflow-wrap: anywhere;
}
.prose h1 {
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.25;
}
.prose h2 {
  font-size: 25px;
  margin-top: 2em;
  border-bottom: 1px solid #e7ebf0;
  padding-bottom: 9px;
}
.prose h3 {
  font-size: 19px;
  margin-top: 1.7em;
}
.prose p,
.prose li {
  color: #34445b;
}
.prose pre,
.source-code {
  background: #14233b;
  color: #e5efff;
  border-radius: 8px;
  overflow-x: auto;
  padding: 18px 20px;
  line-height: 1.65;
  font-size: 13px;
  tab-size: 2;
}
.prose code,
.source-code {
  font-family:
    ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
}
.prose :not(pre) > code {
  background: #edf2f8;
  color: #254d85;
  padding: 2px 5px;
  border-radius: 4px;
  font-size: 0.87em;
}
.prose table {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  border-collapse: collapse;
  font-size: 14px;
}
.prose th,
.prose td {
  border: 1px solid #dce4ed;
  padding: 8px 12px;
  text-align: left;
}
.prose th {
  background: #f2f5f9;
}
.prose img {
  display: block;
  border: 1px solid #e4e9ee;
  border-radius: 8px;
  margin: 20px 0;
}
.prose .katex-display {
  overflow-x: auto;
  overflow-y: hidden;
  padding: 6px 0;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 15px;
  border: 1px solid #cdd9e8;
  border-radius: 7px;
  background: #fff;
  color: #22528e;
  text-decoration: none;
  font: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
}
.button:hover {
  background: #edf4fc;
}
.button.primary {
  background: #285fa6;
  border-color: #285fa6;
  color: #fff;
}
.button.primary:hover {
  background: #1f4e8c;
}
.pill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 12px 0 28px;
}
main .pill-list a {
  font-size: 13px;
  background: #edf3fa;
  border: 1px solid #dce6f3;
  padding: 6px 10px;
  border-radius: 6px;
  text-decoration: none;
}
.section-title {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #687890;
  text-transform: uppercase;
  margin: 34px 0 13px;
}
@media (max-width: 700px) {
  .topbar-inner {
    min-height: 64px;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    gap: 8px;
  }
  .brand {
    font-size: 14px;
  }
  .topbar nav {
    gap: 18px;
  }
  .page-head {
    padding: 36px 0 25px;
  }
  .card-grid {
    grid-template-columns: 1fr;
  }
  .footer-inner {
    flex-direction: column;
  }
}
</style>
