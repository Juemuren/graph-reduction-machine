---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { sitePath } from "../lib/urls";

const { title, description = "λ 演算图归约机的示例、源码与参考文档" } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={description}>
    <title>{title} · Graph Reduction Machine</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={sitePath("/")} aria-label="首页">
          <span class="brand-mark">λ</span>
          <span>Graph Reduction Machine</span>
        </a>
        <nav aria-label="主导航">
          <a href={sitePath("/examples/")}>示例</a>
          <a href={sitePath("/docs/")}>文档</a>
          <a href={sitePath("/docs/lib/")}>标准库</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="container footer-inner">
        <span>Graph Reduction Machine</span>
        <span>从 λ 演算到 SKI 图</span>
      </div>
    </footer>
  </body>
</html>
