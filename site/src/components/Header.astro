---
import { sitePath } from "../lib/urls";
---

<a class="skip-link" href="#main">跳到正文</a>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={sitePath("/")} aria-label="首页">
      <img src={sitePath("/favicon.svg")} alt="" width="64" height="64">
      <span>Graph Reduction Machine</span>
    </a>
    <nav aria-label="主导航">
      <a href={sitePath("/examples/")}>示例</a>
      <a href={sitePath("/docs/")}>文档</a>
      <a href={sitePath("/search/")}>搜索</a>
      <a href="https://github.com/Juemuren/graph-reduction-machine">仓库</a>
    </nav>
  </div>
</header>

<style>
.topbar {
  background: var(--header-bg);
  color: var(--header-text);
}

.topbar-inner {
  max-width: var(--content-width);
  margin: auto;
  padding: 0 var(--page-gutter);
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  color: var(--header-text);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 750;
  letter-spacing: 0.01em;
}

.brand:hover,
.topbar nav a:hover {
  color: var(--header-text);
}

.brand img {
  flex: none;
  width: 34px;
  height: 34px;
}

.topbar nav {
  display: flex;
  gap: 24px;
}

.topbar nav a {
  color: var(--subtext-1);
  text-decoration: none;
  font-size: 14px;
}

.skip-link {
  position: absolute;
  top: -100px;
  left: 12px;
  background: var(--panel-bg);
  padding: 10px;
  z-index: 5;
}

.skip-link:focus {
  top: 12px;
}

@media (max-width: 700px) {
  .topbar-inner {
    min-height: 64px;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding-top: 12px;
    padding-bottom: 12px;
    gap: 8px;
  }

  .brand {
    font-size: 14px;
  }

  .topbar nav {
    gap: 18px;
  }
}
</style>
