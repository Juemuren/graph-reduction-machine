---
import type { TocEntry } from "../lib/content";

const { entries } = Astro.props as { entries: TocEntry[] };
---

{entries.length > 0 && (
  <nav class="toc" aria-label="文章目录">
    <h2>目录</h2>
    <ol>
      {entries.map(({ id, text, level }) => (
        <li style={`--toc-depth: ${level - 2}`}>
          <a href={`#${id}`}>{text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
.toc {
  grid-column: 2;
  grid-row: 1;
  position: sticky;
  top: 24px;
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: var(--card-radius);
  background: var(--panel-bg);
  font-size: 14px;
}

.toc h2 {
  margin: 0 0 12px;
  font-size: 15px;
}

.toc ol {
  list-style: none;
  margin: 0;
  padding: 0;
}

.toc li {
  padding-left: calc(var(--toc-depth) * 12px);
}

.toc a {
  display: block;
  padding: 5px 0;
  color: var(--muted-text);
  text-decoration: none;
  line-height: 1.45;
}

.toc a:hover,
.toc a:focus-visible {
  color: var(--link);
}

@media (max-width: 900px) {
  .toc {
    position: static;
    max-height: 320px;
    width: 100%;
  }
}
</style>
