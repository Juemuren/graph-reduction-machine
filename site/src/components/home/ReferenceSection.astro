---
import { sitePath } from "../../lib/urls";
---

<section class="container reference-section">
  <div class="reference-header">
    <span class="eyebrow">Reference</span>
    <h2>阅读文档</h2>
    <p>语法、编译器、解释器和标准库构成了完整的图归约机系统。</p>
  </div>
  <div class="reference-links">
    <a href={sitePath("/docs/syntax/")}>语法规范<span>↗</span></a>
    <a href={sitePath("/docs/architecture/")}>系统架构<span>↗</span></a>
    <a href={sitePath("/docs/lib/")}>标准库<span>↗</span></a>
  </div>
</section>

<style>
.reference-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  align-items: center;
  gap: 56px;
}

.reference-header > h2 {
  font-size: 34px;
  margin: 8px 0 0;
}
.reference-header > p {
  color: var(--muted-text);
  max-width: 500px;
  line-height: 1.7;
  margin-bottom: 0;
}

.reference-links {
  display: grid;
  gap: 10px;
}
.reference-links a {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  background: var(--page-bg);
  border: 1px solid var(--border);
  padding: 16px 20px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
}
.reference-links span {
  color: var(--overlay-1);
}

@media (max-width: 800px) {
  .reference-section {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .reference-links {
    max-width: 520px;
  }
}
</style>
