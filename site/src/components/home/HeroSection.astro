---
import { sitePath } from "../../lib/urls";
---

<section class="container hero-section">
  <div>
    <span class="eyebrow">Lambda Calculus · Graph Reduction</span>
    <h1>从 λ 演算到 SKI 图</h1>
    <p>一个可运行 λ 演算的图归约机，拥有和图灵机相同的计算能力。</p>
    <div class="hero-actions">
      <a class="button primary" href={sitePath("/examples/")}>浏览示例</a>
      <a class="button" href={sitePath("/docs/")}>阅读文档</a>
    </div>
  </div>
  <img
    class="hero-mark"
    src={sitePath("/favicon.svg")}
    alt="λ 演算与 SKI 图的项目标志"
    width="240"
    height="240"
  >
</section>

<style>
.hero-section {
  display: grid;
  grid-template-columns: 1fr 270px;
  align-items: center;
  gap: 40px;
  color: var(--body-text);
}
.hero-section h1 {
  font-size: clamp(42px, 6vw, 70px);
  line-height: 1.08;
  letter-spacing: -0.05em;
  margin: 15px 0 22px;
}
.hero-section p {
  color: var(--subtext-1);
  line-height: 1.8;
  max-width: 620px;
  font-size: 17px;
}
.hero-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 28px;
}
.hero-mark {
  display: block;
  width: 320px;
  height: 320px;
  justify-self: center;
}

@media (max-width: 700px) {
  .hero-section {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .hero-mark {
    display: none;
  }
}
</style>
