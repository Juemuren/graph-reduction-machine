---
import CardGrid from "../../components/CardGrid.astro";
import { referenceDocs } from "../../config";
import Base from "../../layouts/Base.astro";
import { readSource, titleOf } from "../../lib/content";

const items = await Promise.all(
  referenceDocs.map(async (slug) => ({
    slug,
    title: titleOf(await readSource(`docs/${slug}.md`)),
  })),
);
---

<Base title="文档">
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Documents</span>
      <h1>参考文档</h1>
      <p>语言语法、机器架构、编译与归约流程，以及语言服务和标准库。</p>
    </header>
    <CardGrid
      kind="DOCUMENT"
      items={items.map((item) => ({
        href: `/docs/${item.slug}/`,
        title: item.title,
        description: `阅读 ${item.slug}.md →`,
      }))}
    />
  </div>
</Base>
