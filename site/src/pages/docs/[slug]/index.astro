---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ReadingLayout from "../../../components/ReadingLayout.astro";
import { referenceDocs } from "../../../config";
import Base from "../../../layouts/Base.astro";
import { renderMarkdown } from "../../../lib/content";
export function getStaticPaths() {
  return referenceDocs.map((slug) => ({
    params: { slug },
  }));
}
const { slug } = Astro.params;
const { title, html, toc } = await renderMarkdown(`docs/${slug}.md`);
---

<Base title={title}>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs
        items={[
          { label: "首页", href: "/" },
          { label: "文档", href: "/docs/" },
          { label: title },
        ]}
      />
      <span class="eyebrow">Document | {slug}</span>
    </header>
    <ReadingLayout toc={toc}>
      <article class="paper prose" set:html={html} />
    </ReadingLayout>
  </div>
</Base>
