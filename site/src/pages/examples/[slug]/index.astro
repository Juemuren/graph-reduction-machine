---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ReadingLayout from "../../../components/ReadingLayout.astro";
import Base from "../../../layouts/Base.astro";
import { examples, renderMarkdown } from "../../../lib/content";
import { sitePath } from "../../../lib/urls";
export async function getStaticPaths() {
  return (await examples()).map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}
const { item } = Astro.props;
const { title, html, toc } = await renderMarkdown(
  `examples/${item.slug}/README.md`,
);
---

<Base title={title}>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs
        items={[
          { label: "首页", href: "/" },
          { label: "示例", href: "/examples/" },
          { label: item.label },
        ]}
      />
      <span class="eyebrow">Example | {item.slug}</span>
    </header>
    <ReadingLayout toc={toc}>
      <article class="paper">
        <div class="prose" set:html={html} />
        {item.sources.length > 0 && (
          <>
            <h2 class="section-title">源码</h2>
            <div class="pill-list">
              {item.sources.map((file) => (
                <a href={sitePath(`/examples/${item.slug}/${file}/`)}>
                  {file} ↗
                </a>
              ))}
            </div>
          </>
        )}
        {item.data.length > 0 && (
          <>
            <h2 class="section-title">比较数据</h2>
            <div class="pill-list">
              {item.data.map((file) => (
                <a
                  href={sitePath(`/assets/examples/${item.slug}/${file}`)}
                  download
                >
                  {file} ↓
                </a>
              ))}
            </div>
          </>
        )}
        {item.compare && (
          <>
            <h2 class="section-title">比较配置</h2>
            <div class="pill-list">
              <a
                href={sitePath(`/assets/examples/${item.slug}/compare.json`)}
                download
              >
                compare.json ↓
              </a>
            </div>
          </>
        )}
      </article>
    </ReadingLayout>
  </div>
</Base>
