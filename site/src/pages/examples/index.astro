---
import CardGrid from "../../components/CardGrid.astro";
import Base from "../../layouts/Base.astro";
import { examples } from "../../lib/content";

const items = await examples();
---

<Base title="示例">
  <div class="container">
    <header class="page-head">
      <span class="eyebrow">Examples</span>
      <h1>示例</h1>
    </header>
    <CardGrid
      kind="EXAMPLE"
      items={items.map((item) => ({
        href: `/examples/${item.slug}/`,
        title: item.label,
        description: `${item.sources.length} 个源码文件`,
        extra: item.data.length ? `${item.data.length} 份比较数据` : undefined,
      }))}
    />
  </div>
</Base>
