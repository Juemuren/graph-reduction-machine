---
import Base from "../../layouts/Base.astro";
import { examples } from "../../lib/content";

const items = await examples();
---

<Base title="示例"
  ><div class="container">
    <header class="page-head">
      <span class="eyebrow">Examples</span>
      <h1>从基础到应用</h1>
      <p>
        七组示例保留仓库中的原始说明、公式、源码与已生成的比较结果。选择主题，继续阅读。
      </p>
    </header>
    <div class="card-grid">
      {items.map((item, index) => (
        <a class="card" href={`/examples/${item.slug}/`}>
          <small>{String(index + 1).padStart(2, "0")} / EXAMPLE</small>
          <h2>{item.label}</h2>
          <p>
            {item.sources.length} 个源码文件
            {item.data.length ? ` · ${item.data.length} 份比较数据` : ""}
          </p>
        </a>
      ))}
    </div>
  </div></Base
>
