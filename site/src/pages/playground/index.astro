---
import { stageLabels } from "../../config";
import Base from "../../layouts/Base.astro";
import { sitePath } from "../../lib/urls";

const encodings = ["church", "scott", "binary"];
---

<Base title="演练">
  <div class="container">
    <header class="page-head">
      <h1>演练</h1>
    </header>
    <div class="workspace">
      <section class="editor-section" aria-labelledby="editor-heading">
        <div class="section-head">
          <h2 id="editor-heading">源码</h2>
          <a href={sitePath("/examples/")}>浏览示例</a>
        </div>
        <fieldset id="session">
          <div class="file-controls">
            <label for="files">当前文件</label>
            <select id="files"></select>
            <button class="button" id="remove-file" type="button">删除</button>
          </div>
          <div class="source-editor">
            <pre
              id="source-highlight"
              class="line-content"
              aria-hidden="true"
            ></pre>
            <textarea
              id="source"
              aria-label="当前文件源码"
              spellcheck="false"
              autocapitalize="off"
              wrap="off"
            ></textarea>
          </div>
          <form class="file-controls" id="add-file">
            <label for="file-path">文件路径</label>
            <input id="file-path" placeholder="例如 lib/helper.lambda" required>
            <button class="button" type="submit">添加文件</button>
          </form>
          <p id="file-error" role="alert"></p>
        </fieldset>
      </section>

      <section class="settings-section" aria-labelledby="settings-heading">
        <div class="section-head">
          <h2 id="settings-heading">运行设置</h2>
        </div>
        <form id="run-settings">
          <label for="stage">运行阶段</label>
          <select id="stage">
            {Object.entries(stageLabels).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <fieldset id="compiler-options">
            <legend>编译选项</legend>
            <label for="reduction">λ 归约方式</label>
            <select id="reduction">
              <option value="none">关闭</option>
              <option value="beta">β</option>
              <option value="eta">η</option>
              <option value="both">β + η</option>
            </select>
            <label for="encode-natural">自然数编码</label>
            <select id="encode-natural">
              {encodings.map((value) => <option>{value}</option>)}
            </select>
            <label for="encode-string">字符串编码</label>
            <select id="encode-string">
              {["church", "scott"].flatMap((list) =>
                encodings.map((natural) => (
                  <option
                    selected={list === "church" && natural === "binary"}
                  >{`${list}<${natural}>`}</option>
                )),
              )}
            </select>
          </fieldset>
          <fieldset id="interpreter-options">
            <legend>解释选项</legend>
            <label for="steps">归约步数上限</label>
            <input
              id="steps"
              type="number"
              value="100000"
              min="0"
              max="2147483647"
              step="1"
              required
            >
            <div class="settings-group" id="decode-options">
              <label for="decode">解码类型</label>
              <input id="decode" list="decode-types" value="natural" required>
              <datalist id="decode-types">
                {[
                  "natural",
                  "scott-natural",
                  "binary-natural",
                  "boolean",
                  "integer",
                  "rational",
                  "real",
                  "string",
                  "list<natural>",
                  "scott-list<natural>",
                  "pair<natural,boolean>",
                ].map((value) => <option value={value} />)}
              </datalist>
              <div class="settings-group" id="precision-options" hidden>
                <label for="precision">实数精度</label>
                <input
                  id="precision"
                  type="number"
                  value="0"
                  min="0"
                  max="2147483647"
                  step="1"
                  required
                >
              </div>
            </div>
          </fieldset>
          <div class="run-actions">
            <button class="button primary" id="run" type="submit">运行</button>
            <button class="button" id="cancel" type="button" disabled>
              取消
            </button>
          </div>
        </form>
      </section>

      <section class="result-section" aria-labelledby="result-heading">
        <div class="section-head">
          <h2 id="result-heading">结果</h2>
          <span id="step-count"></span>
        </div>
        <p id="run-status" role="status">尚未运行</p>
        <pre class="source-code line-content" id="output" hidden></pre>
      </section>
    </div>
  </div>
</Base>

<script>
import { startPlayground } from "../../lib/playground-ui";

void startPlayground();
</script>

<style>
.workspace {
  --section-spacing: 24px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
  gap: var(--section-spacing);
  margin-bottom: 56px;
}

.workspace > section {
  min-width: 0;
}
.settings-section {
  border-inline-start: 1px solid var(--border);
  padding-inline-start: var(--section-spacing);
}
.result-section {
  grid-column: 1 / -1;
  border-top: 1px solid var(--border);
  padding-top: var(--section-spacing);
}

.section-head,
.file-controls,
.run-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}
.section-head {
  justify-content: space-between;
  margin-bottom: 16px;
}
.section-head h2 {
  margin: 0;
  font-size: 1.25rem;
}

fieldset {
  min-width: 0;
  border: 0;
  padding: 0;
  margin: 0;
}
#run-settings,
#run-settings fieldset:not([hidden]),
.settings-group:not([hidden]) {
  display: grid;
  gap: 8px;
}
#run-settings fieldset {
  margin-top: 8px;
  padding-top: 7px;
  border-top: 1px solid var(--border);
}
legend {
  padding: 0 8px 0 0;
  color: var(--muted-text);
}
legend,
label,
#step-count {
  font-size: 0.875rem;
}

input,
select,
.workspace .button {
  min-height: 2.5rem;
}
input,
select {
  min-width: 0;
  border: 1px solid var(--surface-1);
  border-radius: 7px;
  background: color-mix(in srgb, var(--surface-0) 35%, transparent);
  color: var(--body-text);
  padding: 8px 10px;
  font: inherit;
}
select {
  appearance: none;
  padding-inline-end: 2rem;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted-text) 50%),
    linear-gradient(135deg, var(--muted-text) 50%, transparent 50%);
  background-position:
    right 15px center,
    right 10px center;
  background-size: 5px 5px;
  background-repeat: no-repeat;
}
:is(select, input[list]):enabled {
  cursor: pointer;
}
:is(input, select):enabled:hover {
  border-color: var(--overlay-1);
}
:is(input, select):focus-visible,
.source-editor:focus-within {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
#files,
#file-path {
  flex: 1 1 10rem;
}
.run-actions {
  margin-top: 8px;
}
.workspace .button {
  padding-block: 6px;
}
.workspace .button:not(.primary) {
  border-color: var(--surface-1);
  color: var(--body-text);
}
.workspace .button:disabled {
  border-color: var(--border);
  background: transparent;
  color: var(--muted-text);
  cursor: not-allowed;
}
#remove-file:enabled:hover {
  border-color: var(--red);
  color: var(--red);
}
#run {
  flex: 1;
}

.source-editor {
  position: relative;
  margin: 12px 0;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: var(--code-bg);
}
#source,
#source-highlight {
  margin: 0;
  border: 0;
  padding: 12px;
  font:
    0.95rem / 1.65 ui-monospace,
    monospace;
  letter-spacing: normal;
  tab-size: 2;
  white-space: pre;
  font-variant-ligatures: none;
}
#source {
  position: relative;
  display: block;
  width: 100%;
  min-height: 25rem;
  resize: vertical;
  outline: none;
  background: transparent;
  color: var(--code-text);
  caret-color: var(--code-text);
}
#source-highlight {
  position: absolute;
  inset: 0 auto auto 0;
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  pointer-events: none;
  color: var(--code-text);
  visibility: hidden;
}
.source-editor[data-highlighted] #source-highlight {
  visibility: visible;
}
.source-editor[data-highlighted] #source {
  color: transparent;
}
#source::selection {
  background: var(--surface-1);
  color: var(--code-text);
}

#run-status,
#file-error {
  margin: 0;
}
#file-error:not(:empty) {
  margin-top: 10px;
}
#run-status,
#step-count {
  color: var(--muted-text);
}
#file-error,
#run-status[data-error="true"] {
  color: var(--red);
}
#output {
  min-height: 3.5rem;
  max-height: 28rem;
  margin: 12px 0 0;
  border: 1px solid var(--border);
  border-inline-start: 3px solid var(--teal);
  font-size: 0.95rem;
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
#run-status[data-error="true"] + #output {
  border-inline-start-color: var(--red);
}

@media (forced-colors: active) {
  select {
    appearance: auto;
  }
  .source-editor[data-highlighted] #source {
    color: CanvasText;
  }
  .source-editor[data-highlighted] #source-highlight {
    visibility: hidden;
  }
}
@media (max-width: 760px) {
  .workspace {
    grid-template-columns: minmax(0, 1fr);
  }
  .settings-section {
    border-inline-start: 0;
    border-top: 1px solid var(--border);
    padding: var(--section-spacing) 0 0;
  }
  #source {
    min-height: 16rem;
  }
}
</style>
