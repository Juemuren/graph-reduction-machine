---
import { stageLabels } from "../../config";
import Base from "../../layouts/Base.astro";
import { examples } from "../../lib/content";

const runnableExamples = (await examples()).flatMap(
  ({ slug, label, sources }) => {
    const entry = sources.find((file) => /\.(lambda|ski)$/.test(file));
    return entry ? [{ slug, label, entry: `${slug}/${entry}` }] : [];
  },
);

const encodings = ["church", "scott", "binary"];
---

<Base title="演练" fillViewport>
  <section class="workspace" aria-label="演练">
    <form id="run-settings">
      <div class="toolbar">
        <div class="toolbar-file">
          <button
            class="button"
            id="toggle-files"
            type="button"
            aria-controls="file-sidebar"
            aria-expanded="true"
          >
            资源管理器
          </button>
          <span id="active-file" class="active-file">main.lambda</span>
          <select id="load-example" aria-label="载入示例" disabled>
            <option value="" selected disabled>载入示例</option>
            {runnableExamples.map(({ slug, label, entry }) => (
              <option value={entry} data-example={slug}>
                {label}
              </option>
            ))}
          </select>
        </div>
        <div class="toolbar-actions">
          <select id="stage" aria-label="运行阶段">
            {Object.entries(stageLabels).map(([value, label]) => (
              <option value={value}>{label}</option>
            ))}
          </select>
          <button
            class="button"
            id="toggle-settings"
            type="button"
            aria-controls="advanced-settings"
            aria-expanded="false"
          >
            运行设置
          </button>
          <button class="button" id="cancel" type="button" hidden>取消</button>
          <button class="button primary" id="run" type="submit">运行</button>
        </div>
      </div>
      <div class="settings-grid" id="advanced-settings" hidden>
        <fieldset id="compiler-options">
          <legend>编译选项</legend>
          <div class="settings-group" id="reduction-options">
            <label for="reduction">归约规则</label>
            <select id="reduction">
              <option value="none">无</option>
              <option value="beta">β</option>
              <option value="eta">η</option>
              <option value="both">β + η</option>
            </select>
          </div>
          <label for="encode-natural">自然数编码</label>
          <select id="encode-natural">
            {encodings.map((value) => <option>{value}</option>)}
          </select>
          <label for="encode-string">字符串编码</label>
          <select id="encode-string">
            {["church", "scott"].flatMap((list) =>
              encodings.map((natural) => (
                <option
                  selected={list === "church" && natural === "binary"}
                >{`${list}<${natural}>`}</option>
              )),
            )}
          </select>
        </fieldset>
        <fieldset id="interpreter-options">
          <legend>解释选项</legend>
          <label for="steps">步数上限</label>
          <input
            id="steps"
            type="number"
            value="100000"
            min="0"
            max="2147483647"
            step="1"
            required
          >
          <div class="settings-group" id="decode-options">
            <label for="decode">解码类型</label>
            <input id="decode" list="decode-types" value="natural" required>
            <datalist id="decode-types">
              {[
                "natural",
                "scott-natural",
                "binary-natural",
                "boolean",
                "integer",
                "rational",
                "real",
                "string",
                "list<natural>",
                "scott-list<natural>",
                "pair<natural,boolean>",
              ].map((value) => <option value={value} />)}
            </datalist>
            <div class="settings-group" id="precision-options" hidden>
              <label for="precision">实数精度</label>
              <input
                id="precision"
                type="number"
                value="0"
                min="0"
                max="2147483647"
                step="1"
                required
              >
            </div>
          </div>
        </fieldset>
      </div>
    </form>

    <div class="editor-workspace" id="session">
      <aside
        class="file-sidebar"
        id="file-sidebar"
        aria-labelledby="files-heading"
      >
        <div class="file-sidebar-head">
          <h2 id="files-heading">文件</h2>
          <button
            class="button"
            id="new-file"
            type="button"
            aria-controls="add-file"
            aria-expanded="false"
          >
            新建文件
          </button>
        </div>
        <form id="add-file" hidden>
          <input
            id="file-path"
            aria-label="新文件路径"
            placeholder="lib/helper.lambda"
            required
          >
          <button class="button" type="submit">添加</button>
          <p id="file-error" role="alert"></p>
        </form>
        <ul id="files" class="file-tree"></ul>
      </aside>
      <div class="source-editor" id="source"></div>
    </div>

    <p id="language-status" role="status"></p>
    <details class="result-section" id="results">
      <summary>
        <span class="result-label">输出</span>
        <span id="run-status" role="status">尚未运行</span>
        <span id="step-count"></span>
      </summary>
      <pre class="source-code line-content" id="output" hidden></pre>
    </details>
  </section>
</Base>

<script>
import { startPlayground } from "../../lib/playground/ui";

void startPlayground();
</script>

<style>
.workspace {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  background: var(--code-bg);
}
.workspace [hidden] {
  display: none;
}
.toolbar,
.toolbar-file,
.toolbar-actions,
.file-sidebar-head {
  display: flex;
  align-items: center;
  gap: 8px;
}
.toolbar {
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  background: var(--panel-bg);
}
.toolbar-file {
  min-width: 0;
}
.active-file {
  overflow: hidden;
  font-family: ui-monospace, monospace;
  font-size: 0.875rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}
#load-example {
  flex: none;
  max-width: 9rem;
}
.toolbar-actions {
  flex-shrink: 0;
}
.workspace .button {
  padding: 5px 10px;
  font-size: 0.875rem;
  white-space: nowrap;
}
.workspace .button:not(.primary) {
  border-color: transparent;
  background: transparent;
  color: var(--body-text);
  font-weight: 600;
}
.workspace .button:not(.primary):hover:not(:disabled) {
  background: var(--surface-0);
}
.workspace .button[aria-expanded="true"] {
  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  color: var(--accent);
}
.workspace .button:disabled {
  opacity: 0.65;
}
#run {
  min-width: 4rem;
}
.result-section {
  border-top: 1px solid var(--border);
}
.result-section > summary {
  padding: 8px 14px;
  color: var(--body-text);
  font-size: 0.875rem;
  cursor: pointer;
}
.result-section > summary:hover {
  background: var(--surface-0);
}
.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px 24px;
  padding: 14px 16px 16px;
  border-top: 1px solid var(--border);
  background: color-mix(in srgb, var(--page-bg) 55%, var(--surface-0));
}
.settings-grid fieldset {
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
.settings-grid fieldset:not([hidden]) {
  display: grid;
  align-content: start;
  grid-template-columns: minmax(6rem, max-content) minmax(0, 18rem);
  gap: 8px 12px;
}
.settings-group:not([hidden]) {
  display: contents;
}
label {
  align-self: center;
  color: var(--muted-text);
  font-size: 0.875rem;
}
legend {
  margin-block-end: 10px;
  padding: 0;
  color: var(--body-text);
  font-size: 1rem;
  font-weight: 700;
}
input,
select {
  min-width: 0;
  min-height: 2rem;
  padding: 4px 7px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: var(--page-bg);
  color: var(--body-text);
  font: inherit;
  font-size: 0.875rem;
}
select:hover {
  border-color: var(--overlay-0);
}
.workspace :focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

.editor-workspace {
  display: grid;
  flex: 1;
  grid-template-columns: clamp(10rem, 20%, 15rem) minmax(0, 1fr);
  border-top: 1px solid var(--border);
}
.editor-workspace:has(.file-sidebar[hidden]) {
  grid-template-columns: minmax(0, 1fr);
}
.file-sidebar {
  contain: size;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  border-inline-end: 1px solid var(--border);
  background: color-mix(in srgb, var(--panel-bg) 45%, var(--code-bg));
}
.file-sidebar-head {
  justify-content: space-between;
  padding: 6px 8px 6px 12px;
  border-bottom: 1px solid var(--border);
}
.file-sidebar-head h2 {
  margin: 0;
  font-size: 0.875rem;
}
.file-sidebar-head .button,
#add-file .button {
  padding: 3px 6px;
  font-size: 0.8rem;
}
.file-tree,
.file-tree :global(ul) {
  list-style: none;
  margin: 0;
}
.file-tree {
  flex: 1;
  overflow: auto;
  padding: 6px;
}
.file-tree :global(ul) {
  margin-inline-start: 9px;
  border-inline-start: 1px solid var(--border);
  padding-inline-start: 6px;
}
.file-tree :global(.file-row) {
  display: flex;
  border-radius: 4px;
}
.file-tree :global(button),
.file-tree :global(summary) {
  min-height: 1.85rem;
  border: 0;
  border-radius: 4px;
  padding: 3px 6px;
  background: transparent;
  color: var(--body-text);
  font: inherit;
  font-size: 0.875rem;
  cursor: pointer;
}
.file-tree :global(.file-open),
.file-tree :global(summary) {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: start;
}
.file-tree :global(.file-row:has([aria-current="true"])) {
  background: var(--surface-1);
  box-shadow: inset 2px 0 var(--accent);
  font-weight: 600;
}
.file-tree :global(button:hover),
.file-tree :global(summary:hover) {
  background: var(--surface-1);
}
.file-tree :global(.file-delete:hover) {
  color: var(--red);
}
#add-file:not([hidden]) {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6px;
  padding: 8px;
  border-bottom: 1px solid var(--border);
}
#file-error {
  grid-column: 1 / -1;
  margin: 0;
  color: var(--red);
  font-size: 0.8rem;
}
#file-error:empty {
  display: none;
}
#language-status:empty {
  display: none;
}

.source-editor {
  contain: size;
  min-width: 0;
  min-height: 16rem;
  overflow: hidden;
}

.result-label {
  margin-inline-end: 8px;
  font-weight: 600;
}
#run-status,
#step-count {
  color: var(--muted-text);
  font-size: 0.8rem;
}
#run-status[data-error="true"] {
  color: var(--red);
}
#step-count:not(:empty) {
  margin-inline-start: 8px;
}
#output {
  min-height: 3.5rem;
  max-height: min(24rem, 30dvh);
  margin: 0 12px 12px;
  border: 1px solid var(--border);
  border-inline-start: 3px solid var(--teal);
  font-size: 0.875rem;
  overflow: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.result-section:has(#run-status[data-error="true"]) #output {
  border-inline-start-color: var(--red);
}

@media (max-width: 640px) {
  .editor-workspace,
  .settings-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .editor-workspace:has(.file-sidebar:not([hidden])) {
    grid-template-rows: auto 1fr;
  }
  .file-sidebar {
    contain: none;
    border-inline-end: 0;
    border-bottom: 1px solid var(--border);
  }
  .file-tree {
    max-height: 9rem;
  }
}
@media (max-width: 440px) {
  .toolbar {
    flex-wrap: wrap;
  }
  .toolbar-file {
    width: 100%;
  }
  #load-example {
    margin-inline-start: auto;
  }
  .toolbar-actions {
    width: 100%;
    flex-wrap: wrap;
  }
  #run {
    margin-inline-start: auto;
  }
}
</style>
