{
  "nodeModulesDir": "auto",
  "jsrDepsInNodeModules": true,
  "unstable": ["sloppy-imports"],
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:astro"]
  },
  "exclude": [".astro/"],
  "fmt": {
    "include": ["test/", "deno.json"]
  },
  "lint": {
    "include": ["test/", "src/**/*.ts"],
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  },
  "tasks": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build": "deno task build:astro && deno task build:search",
    "build:astro": "astro build",
    "build:search": "pagefind --site dist",
    "typecheck": {
      "dependencies": ["typecheck:astro", "typecheck:deno"]
    },
    "typecheck:astro": "astro check",
    "typecheck:deno": "deno check test/ src/",
    "check": {
      "dependencies": ["check:biome", "check:deno"]
    },
    "check:biome": "biome check . --fix",
    "check:deno": "deno fmt && deno lint",
    "test": "deno test --allow-read --allow-env=SITE_BASE test/",
    "verify": "deno task typecheck && deno task check && deno task build && deno task test"
  },
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@0.9.12",
    "@biomejs/biome": "npm:@biomejs/biome@2.6.6",
    "@std/csv": "jsr:@std/csv@1.0.6",
    "@types/node": "npm:@types/node@26.6.6",
    "astro": "npm:astro@7.4.10",
    "katex": "npm:katex@0.16.22",
    "pagefind": "npm:pagefind@^1.6.0",
    "photoswipe": "npm:photoswipe@5.4.4",
    "rehype-katex": "npm:rehype-katex@7.0.1",
    "rehype-slug": "npm:rehype-slug@6.0.0",
    "rehype-stringify": "npm:rehype-stringify@10.0.1",
    "remark-gfm": "npm:remark-gfm@4.0.1",
    "remark-math": "npm:remark-math@6.0.0",
    "remark-parse": "npm:remark-parse@11.0.0",
    "remark-rehype": "npm:remark-rehype@11.1.2",
    "shiki": "npm:shiki@4.6.0",
    "typescript": "npm:typescript@6.0.3",
    "unified": "npm:unified@11.0.5"
  }
}
