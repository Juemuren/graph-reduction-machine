{
  "nodeModulesDir": "auto",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:astro"]
  },
  "exclude": ["src/**", ".astro/**"],
  "tasks": {
    "dev": "astro dev",
    "build": "astro build && deno task check:links",
    "typecheck": {
      "dependencies": ["typecheck:astro", "typecheck:deno"]
    },
    "typecheck:astro": "astro check",
    "typecheck:deno": "deno check",
    "check:biome": "biome check .",
    "check:links": "deno run --allow-read --allow-env=SITE_BASE scripts/check-links.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "deno test --allow-read --allow-env=SITE_BASE test/",
    "verify": "deno task check && deno task lint && deno task build && deno task test"
  },
  "imports": {
    "@astrojs/check": "npm:@astrojs/check@0.9.12",
    "@biomejs/biome": "npm:@biomejs/biome@2.6.6",
    "@types/node": "npm:@types/node@26.6.6",
    "astro": "npm:astro@7.4.10",
    "katex": "npm:katex@0.16.22",
    "rehype-katex": "npm:rehype-katex@7.0.1",
    "rehype-slug": "npm:rehype-slug@6.0.0",
    "rehype-stringify": "npm:rehype-stringify@10.0.1",
    "remark-gfm": "npm:remark-gfm@4.0.1",
    "remark-math": "npm:remark-math@6.0.0",
    "remark-parse": "npm:remark-parse@11.0.0",
    "remark-rehype": "npm:remark-rehype@11.1.2",
    "shiki": "npm:shiki@4.6.0",
    "typescript": "npm:typescript@6.0.3",
    "unified": "npm:unified@11.0.5"
  }
}
